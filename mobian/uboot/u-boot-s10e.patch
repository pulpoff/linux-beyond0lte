+
+&hsi2c_24 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&hsi2c24_bus>;
+	status = "okay";
+
+	/*
+	 * Only the rails listed here are switched; the others (LDO17 for the
+	 * grip sensor, BUCK1, the buck-boost) keep what S-Boot set. Voltages
+	 * are the ones the PMIC already holds.
