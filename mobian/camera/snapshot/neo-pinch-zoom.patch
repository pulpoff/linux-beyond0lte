             obj.add_controller(controller);
 
+            // Pinch to zoom (digital, camerabin's): the factor follows the pinch from the zoom it started at. On the
+            // whole camera page in the capture phase: the controls' overlay covers the viewfinder and took the
+            // touches before a gesture on the viewfinder saw them; one finger still reaches the buttons.
+            let zoom_gesture = gtk::GestureZoom::new();
+            zoom_gesture.set_propagation_phase(gtk::PropagationPhase::Capture);
+            // While the fingers move only the drawn viewfinder is magnified (smooth, on the GPU); camerabin's zoom,
+            // which crops and rescales the stream (and stuttered when set at every step), is set when they lift.
+            zoom_gesture.connect_begin(glib::clone!(
+                #[weak]
+                obj,
+                move |_, _| {
+                    let imp = obj.imp();
+                    if let Some(id) = imp.zoom_settle.take() {
+                        id.remove();
+                    }
+                    let zoom = imp.viewfinder.zoom();
+                    imp.zoom_start.set(zoom);
+                    imp.zoom_target.set(zoom);
+                }
+            ));
+            zoom_gesture.connect_scale_changed(glib::clone!(
+                #[weak]
+                obj,
+                move |_, scale| {
+                    let imp = obj.imp();
+                    let applied = imp.zoom_start.get();
+                    let target = (applied * scale).clamp(1.0, imp.viewfinder.max_zoom());
+                    imp.zoom_target.set(target);
+                    imp.viewfinder.set_preview_zoom(target / applied);
+                    obj.show_zoom(target);
+                }
+            ));
+            let apply_zoom = glib::clone!(
+                #[weak]
+                obj,
+                move || {
+                    let imp = obj.imp();
+                    let target = imp.zoom_target.get();
+                    if (target - imp.viewfinder.zoom()).abs() < 0.01 {
+                        imp.viewfinder.set_preview_zoom(1.0);
+                        return;
+                    }
+                    let zoom = imp.viewfinder.set_zoom(target);
+                    log::debug!("zoom {zoom:.2}");
+                    // keep the magnified preview until frames with the new crop are through
+                    let id = glib::timeout_add_local_once(
+                        std::time::Duration::from_millis(250),
+                        glib::clone!(
+                            #[weak]
+                            obj,
+                            move || {
+                                let imp = obj.imp();
+                                imp.zoom_settle.replace(None);
+                                imp.viewfinder.set_preview_zoom(1.0);
+                            }
+                        ),
+                    );
+                    if let Some(old) = imp.zoom_settle.replace(Some(id)) {
+                        old.remove();
+                    }
+                }
+            );
+            let apply = apply_zoom.clone();
+            zoom_gesture.connect_end(move |_, _| apply());
+            zoom_gesture.connect_cancel(move |_, _| apply_zoom());
+            obj.add_controller(zoom_gesture);
