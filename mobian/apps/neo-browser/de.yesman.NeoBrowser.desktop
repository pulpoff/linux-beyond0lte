[Desktop Entry]
Type=Application
Name=Browser
GenericName=Web Browser
Comment=Browse the web
Exec=/opt/neo-browser/de.yesman.NeoBrowser.js %U
Icon=de.yesman.Browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=false
StartupWMClass=de.yesman.NeoBrowser
X-Purism-FormFactor=Workstation;Mobile;
