+
+&usi17_i2c {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c_38 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&hsi2c38_bus &amp_irq>;
+	status = "okay";
+
+	/*
+	 * Two CS35L40s on one TDM bus (ABOX UAIF1). Boost values: downstream
+	 * never programs them, and the chip reset defaults decode to 1 uH and
+	 * the <=19 uF cap range.
+	 */
+	spk_amp: amplifier@40 {
+		compatible = "cirrus,cs35l40";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "SPK";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&spk_amp_reset>;
+		reset-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;
+
+		cirrus,boost-type = <0>;
+		cirrus,boost-peak-milliamp = <4100>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+	};
+
+	rcv_amp: amplifier@41 {
+		compatible = "cirrus,cs35l40";
+		reg = <0x41>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "RCV";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&rcv_amp_reset>;
+		reset-gpios = <&gph1 2 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;
+
+		cirrus,boost-type = <0>;
+		cirrus,boost-peak-milliamp = <4100>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+	};
+};
+
+/ {
+	sound {
+		compatible = "samsung,beyond0lte-madera";
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_aif1>;
+		samsung,audio-codec = <&codec>;
+		samsung,audio-cpu = <&abox>;
+		/* TDM slot order: earpiece amp on slot 0, loudspeaker amp on slot 1 */
+		samsung,speaker-amps = <&rcv_amp>, <&spk_amp>;
+	};
+};
+
+/ {
+	/*
+	 * The Shannon modem inside the SoC (S5000AP CP): MCU_IPC mailbox
+	 * "mcu_ipc_cp", the AP2CP_CFG register and the modem_if carve-out,
+	 * as the stock mif_pdata/mcu_ipc/shmem nodes describe them.
+	 */
+	modem {
+		compatible = "samsung,exynos9820-cp";
+		reg = <0x0 0x15920000 0x180>, <0x0 0x15020000 0x4>;
+		reg-names = "mailbox", "ap2cp-cfg";
+		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
+		memory-region = <&modem_if>;
+		samsung,pmu-syscon = <&pmu_system_controller>;
+	};
+};
