   PhoshWayland *wl = phosh_wayland_get_default ();
   PhoshNotifyManager *nm = phosh_notify_manager_get_default ();
-  g_autoptr (GtkCssProvider) css = gtk_css_provider_new ();
+  static GtkCssProvider *css;
   GtkWidget *battery, *bottom;
 
   if (self->monitor == NULL)
@@ -166,9 +166,14 @@
 
   G_OBJECT_CLASS (phosh_aod_parent_class)->constructed (object);
 
-  gtk_css_provider_load_from_data (css, aod_css, -1, NULL);
-  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (), GTK_STYLE_PROVIDER (css),
-                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 10);
+  /* once: a provider added per AOD restyled the whole shell every time the screen went off, before the AOD's
+   * first frame, and they piled up */
+  if (!css) {
+    css = gtk_css_provider_new ();
+    gtk_css_provider_load_from_data (css, aod_css, -1, NULL);
+    gtk_style_context_add_provider_for_screen (gdk_screen_get_default (), GTK_STYLE_PROVIDER (css),
+                                               GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 10);
+  }
   gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "phosh-aod");
 
   /* the clock sits a third down, as on Samsung's AOD; battery and app icons under it */
