 /**
+ * phoc_output_shield_set_snapshot:
+ * @self: The shield
+ * @buffer: (transfer full) (nullable): A locked buffer holding the output's last frame
+ * @texture: (transfer full) (nullable): That buffer as a texture
+ * @transform: How to turn the frame so it looks upright on the output's new transform
+ *
+ * Shows the frame instead of black while the shield is up, and grows it as it fades.
+ */
+void
+phoc_output_shield_set_snapshot (PhocOutputShield         *self,
+                                 struct wlr_buffer        *buffer,
+                                 struct wlr_texture       *texture,
+                                 enum wl_output_transform  transform)
+{
+  g_assert (PHOC_IS_OUTPUT_SHIELD (self));
+
+  g_clear_pointer (&self->snapshot, wlr_texture_destroy);
+  g_clear_pointer (&self->snapshot_buffer, wlr_buffer_unlock);
+  self->snapshot = texture;
+  self->snapshot_buffer = buffer;
+  self->snapshot_transform = transform;
+}
+
+/**
+ * phoc_output_shield_turn_snapshot:
+ * @self: The shield
+ * @by: The turn from the output's current transform to its new one
+ *
+ * Turns the frame shown while the shield is up along with the output.
+ *
+ * Returns: Whether there is such a frame
+ */
+gboolean
+phoc_output_shield_turn_snapshot (PhocOutputShield *self, enum wl_output_transform by)
+{
+  g_assert (PHOC_IS_OUTPUT_SHIELD (self));
+
+  if (!self->snapshot)
+    return FALSE;
+  self->snapshot_transform = wlr_output_transform_compose (self->snapshot_transform, by);
+  return TRUE;
+}
