 static void
 wlr_output_power_handle_mode(void *data,
                              struct zwlr_output_power_v1 *output_power,
@@ -627,6 +647,22 @@
   g_return_if_fail (phosh_monitor_is_configured (self));
   g_return_if_fail (self->wlr_output_power);
 
+  /* Neo: with the always-on display the built-in panel is only marked off. Everything that follows the
+   * power mode (the shell's blanked state, the screen saver, the power button) works as with a blank
+   * panel; the shell puts the AOD overlay on it. */
+  if (mode == PHOSH_MONITOR_POWER_SAVE_MODE_OFF && phosh_monitor_is_builtin (self) && neo_aod_enabled ()) {
+    self->aod = TRUE;
+    self->power_mode = PHOSH_MONITOR_POWER_SAVE_MODE_OFF;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PHOSH_MONITOR_PROP_POWER_MODE]);
+    return;
+  }
+  if (mode == PHOSH_MONITOR_POWER_SAVE_MODE_ON && self->aod) {
+    self->aod = FALSE;
+    self->power_mode = PHOSH_MONITOR_POWER_SAVE_MODE_ON;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PHOSH_MONITOR_PROP_POWER_MODE]);
+    return;
+  }
+
   switch (mode) {
   case PHOSH_MONITOR_POWER_SAVE_MODE_OFF:
     wl_mode = ZWLR_OUTPUT_POWER_V1_MODE_OFF;
