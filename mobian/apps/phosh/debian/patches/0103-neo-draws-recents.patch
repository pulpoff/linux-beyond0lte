 static void
+neo_emit (PhoshHome *self, const char *signal, GVariant *params)
+{
+  if (self->neo_bus)
+    g_dbus_connection_emit_signal (self->neo_bus, NULL, NEO_PHOSH_OBJ, NEO_PHOSH_BUS, signal, params, NULL);
+  else if (params)
+    g_variant_unref (g_variant_ref_sink (params));
+}
+
+
+/* A window's id for Neo: stable while it lives */
+static char *
+neo_window_id (PhoshToplevel *toplevel)
+{
+  return g_strdup_printf ("%p", toplevel);
+}
+
+
+static PhoshToplevel *
+neo_find_window (const char *id)
+{
+  PhoshToplevelManager *m = phosh_shell_get_toplevel_manager (phosh_shell_get_default ());
+
+  for (guint i = 0; i < phosh_toplevel_manager_get_num_toplevels (m); i++) {
+    PhoshToplevel *t = phosh_toplevel_manager_get_toplevel (m, i);
+    g_autofree char *tid = neo_window_id (t);
+
+    if (g_strcmp0 (tid, id) == 0)
+      return t;
+  }
+  return NULL;
+}
+
+
+/* Neo's recents: every window with its thumbnail as raw cairo ARGB32 (BGRA in memory, premultiplied) on the
+ * runtime tmpfs, so Neo makes a texture of it without decoding anything */
+static GVariant *
+neo_get_windows (PhoshHome *self)
+{
+  GVariantBuilder builder;
+  g_autofree char *dir = g_build_filename (g_get_user_runtime_dir (), "neo-recents", NULL);
+  g_autoptr (GList) activities = phosh_overview_get_activities (self->overview);
+  PhoshToplevel *focused = phosh_overview_get_focused_toplevel (self->overview);
+
+  g_mkdir_with_parents (dir, 0700);
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(ssssuuub)"));
+  for (GList *l = activities; l; l = l->next) {
+    PhoshActivity *activity;
+    PhoshToplevel *toplevel;
+    cairo_surface_t *surface;
+    g_autofree char *id = NULL;
+    g_autofree char *path = NULL;
+    guint w = 0, h = 0, stride = 0;
+
+    if (!PHOSH_IS_ACTIVITY (l->data))
+      continue;
+    activity = PHOSH_ACTIVITY (l->data);
+    toplevel = phosh_overview_get_toplevel_from_activity (self->overview, activity);
+    if (!toplevel)
+      continue;
+    id = neo_window_id (toplevel);
+    surface = phosh_activity_get_thumbnail_surface (activity);
+    if (surface && cairo_surface_get_type (surface) == CAIRO_SURFACE_TYPE_IMAGE &&
+        cairo_image_surface_get_format (surface) == CAIRO_FORMAT_ARGB32) {
+      cairo_surface_flush (surface);
+      w = cairo_image_surface_get_width (surface);
+      h = cairo_image_surface_get_height (surface);
+      stride = cairo_image_surface_get_stride (surface);
+      path = g_strdup_printf ("%s/%s.raw", dir, id);
+      if (!g_file_set_contents (path, (const char *) cairo_image_surface_get_data (surface), (gssize) stride * h, NULL))
+        g_clear_pointer (&path, g_free);
+    }
+    g_variant_builder_add (&builder, "(ssssuuub)", id,
+                           phosh_toplevel_get_app_id (toplevel) ?: "",
+                           phosh_toplevel_get_title (toplevel) ?: "",
+                           path ?: "", path ? w : 0, path ? h : 0, path ? stride : 0,
+                           toplevel == focused);
+  }
+  return g_variant_new ("(a(ssssuuub))", &builder);
+}
