+/* Neo: the AOD goes over the lock screen, whichever of the two was made first */
+static void
+neo_aod_over_lockscreen (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshLockscreen *lockscreen = phosh_lockscreen_manager_get_lockscreen (priv->lockscreen_manager);
+
+  if (priv->aod && lockscreen)
+    phosh_layer_surface_set_stacked_above (PHOSH_LAYER_SURFACE (priv->aod), PHOSH_LAYER_SURFACE (lockscreen));
+}
