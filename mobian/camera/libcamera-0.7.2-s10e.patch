diff -ruN a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
--- a/src/ipa/simple/algorithms/af.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ipa/simple/algorithms/af.cpp	2026-10-30 19:27:15.159123012 +0100
@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus for the software ISP (POCO X3 NFC: the IMX682 behind a DW9807 VCM)
+ *
+ * The statistics carry a focus measure from the middle third of the raw image (SwIspStats::sharpness: 4x4 pixel
+ * blocks on a square-root scale against their neighbours), divided here by the mean so that brightness does not
+ * read as sharpness; exposure is also held still while a scan runs (Agc), or its rising gain does.
+ *
+ * A scan starts at scanMin (below it this VCM does not move: its spring holds the lens at the stop) and climbs in
+ * coarseStep steps until the measure has fallen under 0.75 of the best seen, twice (as Raspberry Pi's AF stops),
+ * then goes over the best step's neighbourhood in quarter steps. Every target is approached from below, the way
+ * the coarse pass climbs: the lens stops a little differently coming down. Each reading is the 6th frame after the
+ * move (8th after a long one): a move shows 2 frames later and takes a few more to come to rest. A scan takes 1.5-3 s.
+ * Measured on the POCO 2026-10-14 with a settled probe (LIBCAMERA_AF_PROBE=1, below): 64-384 flat, the scene sharp
+ * at 448-512, a single peak above 384.
+ *
+ * Continuous mode (the default, so that applications that know nothing of autofocus still get it) scans when the
+ * camera starts, and again when the scene has changed: the measure moved away from where it settled for two
+ * readings, then held still for two (so it does not hunt while the phone is still moving).
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdlib.h>
+#include <limits>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+static constexpr double kFallen = 0.75;		/* past the peak: below this share of the best */
+static constexpr double kFlat = 1.08;		/* best/worst below this: nothing to focus on */
+static constexpr double kChangedLow = 0.75;	/* the scene changed: the measure left this band */
+static constexpr double kChangedHigh = 1.4;
+static constexpr double kSteady = 0.12;		/* and then held within this of itself */
+/*
+ * Times, not frames: they were 6, 8 and 36 frames at the 30 fps they were tuned at, and the 60 fps video modes read
+ * every step in half the time, before the VCM had come to rest (the lens hunted, the picture stayed soft).
+ */
+static constexpr double kSettleSeconds = 0.2;		/* a move shows 2 frames later; the VCM in SAC mode rests ~130 ms after */
+static constexpr double kSettleLongSeconds = 0.267;	/* longer after a long travel */
+static constexpr double kStartSeconds = 1.2;		/* the first scan waits for the exposure to settle */
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (!context.configuration.lens.available)
+		return 0;
+
+	min_ = context.configuration.lens.min;
+	max_ = context.configuration.lens.max;
+	maxDioptres_ = tuningData["maxDioptres"].get<double>(10.0);
+	/*
+	 * Below scanMin the lens does not move: the coil's current has not yet overcome the spring that holds it at its
+	 * stop, and every code reads the same (2026-10-14: 64-384 flat on the POCO's IMX682 module). Scans start there,
+	 * and LensPosition 0 (infinity) maps to it.
+	 */
+	scanMin_ = std::clamp(tuningData["scanMin"].get<int32_t>(min_), min_, max_);
+	coarseStep_ = std::max<int32_t>(4, tuningData["coarseStep"].get<int32_t>((max_ - scanMin_) / 10));
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, static_cast<float>(maxDioptres_), 0.0f);
+
+	LOG(IPASoftAf, Info) << "Autofocus over lens positions " << min_ << "-" << max_;
+	return 0;
+}
+
+int Af::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	/*
+	 * Counted at 60 fps, the fastest the soft ISP delivers: the session's exposure limits do not give the frame
+	 * time reliably (they said 33 ms for 60 fps), and erring short only waits longer at 30 fps, never reads early.
+	 */
+	const double frame = 1.0 / 60;
+	auto frames = [frame](double seconds) {
+		return std::max<uint32_t>(3, static_cast<uint32_t>(std::ceil(seconds / frame)));
+	};
+	settleFrames_ = frames(kSettleSeconds);
+	settleLongFrames_ = std::max(settleFrames_ + 1, frames(kSettleLongSeconds));
+	startFrames_ = frames(kStartSeconds);
+	LOG(IPASoftAf, Debug) << "frame " << frame * 1e3 << " ms: settle " << settleFrames_ << "/" << settleLongFrames_
+			      << " frames, first scan at " << startFrames_;
+
+	mode_ = controls::AfModeContinuous;
+	state_ = controls::AfStateIdle;
+	phase_ = Phase::Idle;
+	waiting_ = false;
+	if (context.configuration.lens.available) {
+		/* the lens driver starts at its lowest position (powered down: at rest) */
+		context.activeState.lens.position = min_;
+		context.activeState.lens.changed = false;
+	}
+	return 0;
+}
+
+double Af::dioptres(int32_t position) const
+{
+	return max_ > scanMin_ ? std::max(0, position - scanMin_) * maxDioptres_ / (max_ - scanMin_) : 0.0;
+}
+
+int32_t Af::position(double d) const
+{
+	return std::clamp(scanMin_ + static_cast<int32_t>(std::lround(d * (max_ - scanMin_) / maxDioptres_)), scanMin_, max_);
+}
+
+void Af::moveTo(IPAContext &context, int32_t position, uint32_t frame)
+{
+	position = std::clamp(position, min_, max_);
+	/* a long travel takes the VCM longer to settle: one frame more */
+	settle_ = std::abs(position - context.activeState.lens.position) > (max_ - min_) / 6 ? settleLongFrames_ : settleFrames_;
+	context.activeState.lens.position = position;
+	context.activeState.lens.changed = true;
+	movedAt_ = frame;
+	waiting_ = true;
+}
+
+void Af::startScan(IPAContext &context, uint32_t frame)
+{
+	targets_.clear();
+	for (int32_t p = scanMin_; p < max_; p += coarseStep_)
+		targets_.push_back(p);
+	targets_.push_back(max_);
+	next_ = 0;
+	best_ = 0;
+	worst_ = std::numeric_limits<double>::max();
+	fallen_ = 0;
+	phase_ = Phase::Coarse;
+	state_ = controls::AfStateScanning;
+	context.activeState.lens.scanning = true;
+	approach_ = -1;
+	changed_ = steady_ = 0;
+	moveTo(context, targets_[next_], frame);
+}
+
+/* A reading at targets_[next_]; false while the scan goes on (and the lens has moved on), true when it is over. */
+bool Af::step(IPAContext &context, uint32_t frame, double value)
+{
+	const int32_t at = targets_[next_];
+	LOG(IPASoftAf, Debug) << "step frame " << frame << " pos " << at << " value " << value;
+
+	if (value > best_) {
+		best_ = value;
+		bestPos_ = at;
+		fallen_ = 0;
+	} else if (value < kFallen * best_) {
+		fallen_++;
+	}
+	worst_ = std::min(worst_, value);
+
+	/*
+	 * Above scanMin the curve has one peak: once the measure has fallen to kFallen of the best seen, twice, the
+	 * peak is behind (as Raspberry Pi's AF does). Below scanMin it looked like two (the lens at rest reads sharper
+	 * than at code 64), which is why scans no longer go there.
+	 */
+	if (++next_ < targets_.size() && fallen_ < 2) {
+		moveTo(context, targets_[next_], frame);
+		return false;
+	}
+
+	if (phase_ == Phase::Coarse && coarseStep_ >= 4) {
+		/* the best step's neighbourhood, in quarter steps */
+		const int32_t fine = coarseStep_ / 4;
+		const int32_t from = std::max(scanMin_, bestPos_ - coarseStep_ / 2), to = std::min(max_, bestPos_ + coarseStep_ / 2);
+		const double coarseWorst = worst_;
+		targets_.clear();
+		for (int32_t p = from; p <= to; p += fine)
+			targets_.push_back(p);
+		next_ = 0;
+		/* the VCM stops a little differently coming down than going up: approach from below, as the coarse pass did */
+		approach_ = std::max(min_, from - 2 * fine);	/* (may be below scanMin: only passed through) */
+		best_ = 0;
+		worst_ = coarseWorst;
+		fallen_ = 0;
+		phase_ = Phase::Fine;
+		moveTo(context, approach_, frame);
+		return false;
+	}
+
+	return true;
+}
+
+void Af::finishScan(IPAContext &context, uint32_t frame)
+{
+	const bool flat = best_ < kFlat * worst_;
+	/* nothing to focus on (dark, blank wall, covered): the best of a flat curve is noise, often the macro end;
+	 * rest near infinity instead, where most of what the camera is pointed at next will be */
+	if (flat)
+		bestPos_ = std::min(max_, scanMin_ + coarseStep_);
+
+	state_ = flat ? controls::AfStateFailed : controls::AfStateFocused;
+	phase_ = Phase::Focused;
+	context.activeState.lens.scanning = false;
+	reference_ = 0;			/* the first reading at the new position */
+	changed_ = steady_ = 0;
+	approach_ = std::max(min_, bestPos_ - coarseStep_ / 2);
+	moveTo(context, approach_, frame);
+
+	LOG(IPASoftAf, Debug) << (flat ? "No contrast to focus on" : "Focused") << " at " << bestPos_
+			      << " (best " << best_ << ", worst " << worst_ << ")";
+}
+
+void Af::queueRequest(IPAContext &context, const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.configuration.lens.available)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		phase_ = Phase::Idle;
+		context.activeState.lens.scanning = false;
+		state_ = controls::AfStateIdle;
+		waiting_ = false;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart) {
+			startScan(context, frame);
+		} else {
+			phase_ = Phase::Idle;
+			state_ = controls::AfStateIdle;
+			context.activeState.lens.scanning = false;
+		}
+	}
+
+	const auto &lens = controls.get(controls::LensPosition);
+	if (lens && mode_ == controls::AfModeManual)
+		moveTo(context, position(*lens), frame);
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.configuration.lens.available)
+		return;
+
+	metadata.set(controls::AfState, state_);
+	metadata.set(controls::LensPosition, static_cast<float>(dioptres(context.activeState.lens.position)));
+
+	/* tuning aid: LIBCAMERA_AF_PROBE=1 steps the lens 0..1023 by 64, 12 frames each, and logs every frame (the settled focus curve, scanMin) */
+	static const bool probe = getenv("LIBCAMERA_AF_PROBE");
+	if (probe) {
+		const int32_t pos = std::min<int32_t>(max_, static_cast<int32_t>(frame / 12) * 64);
+		if (pos != context.activeState.lens.position) {
+			context.activeState.lens.position = pos;
+			context.activeState.lens.changed = true;
+		}
+		if (stats->sharpnessCount) {
+			const double m = stats->sharpnessLevel / (stats->sharpnessCount / 6.0);
+			LOG(IPASoftAf, Debug) << "probe " << frame << " " << pos << " " << static_cast<double>(stats->sharpness) / stats->sharpnessCount / (m + 1.0);
+		}
+		return;
+	}
+
+	if (mode_ == controls::AfModeContinuous && phase_ == Phase::Idle) {
+		if (frame >= startFrames_)
+			startScan(context, frame);
+		return;
+	}
+
+	if (!stats->sharpnessCount)
+		return;
+	/* the frame was (partly) exposed before the lens got there */
+	if (waiting_ && frame < movedAt_ + settle_)
+		return;
+	waiting_ = false;
+
+	/* sharpnessLevel sums the blocks' square-root values, 6 counts per block */
+	const double mean = stats->sharpnessLevel / (stats->sharpnessCount / 6.0);
+	/* on a square-root scale (SwStatsCpu::sharpness10P()): divided by the mean, not its square */
+	const double value = static_cast<double>(stats->sharpness) / stats->sharpnessCount / (mean + 1.0);
+
+	if (approach_ >= 0) {
+		approach_ = -1;
+		moveTo(context, phase_ == Phase::Focused ? bestPos_ : targets_[next_], frame);
+		last_ = value;
+		return;
+	}
+
+	switch (phase_) {
+	case Phase::Coarse:
+	case Phase::Fine:
+		if (step(context, frame, value))
+			finishScan(context, frame);
+		break;
+
+	case Phase::Focused:
+		if (reference_ == 0) {
+			reference_ = value;
+			break;
+		}
+		if (mode_ != controls::AfModeContinuous)
+			break;
+		LOG(IPASoftAf, Debug) << "monitor " << frame << " " << value / reference_;
+		if (changed_ < 2) {
+			/*
+			 * Sharper at the same lens position is still in focus: after a scan the exposure settles and the
