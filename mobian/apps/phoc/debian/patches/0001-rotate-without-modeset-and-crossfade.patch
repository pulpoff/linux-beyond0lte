+        .texture = self->snapshot,
+        .dst_box = { (W - iw * s) / 2, (H - ih * s) / 2, iw * s, ih * s },
+        .alpha = &alpha,
+        .transform = self->snapshot_transform,
+        .filter_mode = WLR_SCALE_FILTER_BILINEAR,
+        .clip = ctx->damage,
+      });
