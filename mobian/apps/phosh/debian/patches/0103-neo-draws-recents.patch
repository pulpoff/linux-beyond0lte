+    g_dbus_method_invocation_return_value (invocation, neo_get_windows (self));
+    return;
+  } else if (g_strcmp0 (method_name, "Activate") == 0 || g_strcmp0 (method_name, "Close") == 0) {
+    const char *id;
+    PhoshToplevel *toplevel;
+
+    g_variant_get (parameters, "(&s)", &id);
+    toplevel = neo_find_window (id);
+    if (toplevel && method_name[0] == 'A')
+      phosh_toplevel_activate (toplevel, phosh_wayland_get_wl_seat (phosh_wayland_get_default ()));
+    else if (toplevel)
+      phosh_toplevel_close (toplevel);
+  } else if (g_strcmp0 (method_name, "CloseAll") == 0) {
+    PhoshToplevelManager *m = phosh_shell_get_toplevel_manager (phosh_shell_get_default ());
+
+    for (int i = (int) phosh_toplevel_manager_get_num_toplevels (m) - 1; i >= 0; i--)
+      phosh_toplevel_close (phosh_toplevel_manager_get_toplevel (m, i));
   }
   g_dbus_method_invocation_return_value (invocation, NULL);
 }
