@@ -206,14 +250,34 @@
 }
 
 static void
+answer_call (GTask *task)
+{
+    AcceptContext *ctx = g_task_get_task_data (task);
+    QmiMessageVoiceAnswerCallInput *input;
+
+    ctx->attempts++;
+    input = qmi_message_voice_answer_call_input_new ();
+    qmi_message_voice_answer_call_input_set_call_id (input, ctx->call_id, NULL);
+
+    mm_obj_dbg (g_task_get_source_object (task), "Accepting call with id: %u", ctx->call_id);
+    qmi_client_voice_answer_call (ctx->client,
+                                  input,
+                                  5,
+                                  NULL,
+                                  (GAsyncReadyCallback) voice_answer_call_ready,
+                                  task);
+    qmi_message_voice_answer_call_input_unref (input);
+}
