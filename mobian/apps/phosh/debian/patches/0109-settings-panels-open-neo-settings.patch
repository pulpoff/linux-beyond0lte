Description: settings panels open Neo Settings
 Every "launch-panel" and "launch-mobile-panel" (quick settings long press, status pages,
 the app grid) goes to de.yesman.NeoSettings when it is installed, never GNOME Settings or
 Mobile Settings; the hotspot status page asks for the hotspot page, not Wi-Fi, and the brightness
 slider for Display, not Power.
Author: pulpoff <pashkovsky@gmail.com>
---
Index: phosh-0.58.0/plugins/wifi-hotspot-quick-setting/status-page.ui
===================================================================
--- phosh-0.58.0.orig/plugins/wifi-hotspot-quick-setting/status-page.ui
+++ phosh-0.58.0/plugins/wifi-hotspot-quick-setting/status-page.ui
@@ -77,7 +77,7 @@
     <property name="hexpand">1</property>
     <property name="focus-on-click">0</property>
     <property name="action-name">panel.launch-panel</property>
-    <property name="action-target">(&quot;wifi&quot;, [&lt;&quot;&quot;&gt;])</property>
+    <property name="action-target">(&quot;wifi-hotspot&quot;, [&lt;&quot;&quot;&gt;])</property>
     <child>
       <object class="GtkLabel">
         <property name="visible">1</property>
Index: phosh-0.58.0/src/app-grid-button.c
===================================================================
--- phosh-0.58.0.orig/src/app-grid-button.c
+++ phosh-0.58.0/src/app-grid-button.c
@@ -437,7 +437,9 @@ on_open_panel_ready (GObject *source_obj
   }
 
   /* Let the rest of the shell know that we spawned settings from the app-grid */
-  info = g_desktop_app_info_new ("mobi.phosh.MobileSettings.desktop");
+  info = g_desktop_app_info_new ("de.yesman.NeoSettings.desktop");
+  if (!info)
+    info = g_desktop_app_info_new ("mobi.phosh.MobileSettings.desktop");
   g_signal_emit (self, signals[APP_LAUNCHED], 0, info);
 }
 
Index: phosh-0.58.0/src/util.c
===================================================================
--- phosh-0.58.0.orig/src/util.c
+++ phosh-0.58.0/src/util.c
@@ -948,7 +948,11 @@ phosh_util_open_settings_panel (const ch
 
   g_return_if_fail (params != NULL);
 
-  if (mobile) {
+  /* Neo: Neo Settings answers every panel, GNOME Settings' names and Mobile Settings' alike */
+  info = g_desktop_app_info_new ("de.yesman.NeoSettings.desktop");
+  if (info) {
+    action = "launch-panel";
+  } else if (mobile) {
     info = g_desktop_app_info_new ("mobi.phosh.MobileSettings.desktop");
     action = "set-panel";
   } else {
