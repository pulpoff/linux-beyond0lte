+/**
+ * PhoshAod:
+ *
+ * Neo: the always-on display. While the built-in panel is "blanked" with `de.yesman.neo aod` on, the
+ * panel stays lit and this black overlay shows the time, the date, the battery and one icon per app
+ * with notifications. Black pixels cost nothing on OLED; the text is dim grey. The content moves a
+ * little every minute so no pixel stays lit for long.
+ */
+
+#define AOD_SHIFT 24 /* px the content wanders, against burn-in */
+
+struct _PhoshAod {
+  PhoshLayerSurface  parent;
+  PhoshMonitor      *monitor;
+
+  GtkWidget         *box;
+  GtkWidget         *time;
+  GtkWidget         *date;
+  GtkWidget         *icons;
+  GListModel        *sources;
+  guint              step;
+};
+
+G_DEFINE_TYPE (PhoshAod, phosh_aod, PHOSH_TYPE_LAYER_SURFACE)
+
+enum {
+  PROP_0,
+  PROP_MONITOR,
+  PROP_LAST_PROP,
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+static const char aod_css[] =
+  ".phosh-aod { background: black; }"
+  ".phosh-aod label { color: #8a8a8a; }"
+  ".phosh-aod .aod-time { font-size: 64px; font-weight: 300; }"
+  ".phosh-aod .aod-date { font-size: 17px; }"
+  ".phosh-aod image { color: #8a8a8a; -gtk-icon-effect: dim; }";
+
+
+static void
+update_clock (PhoshAod *self)
+{
+  PhoshWallClock *clock = phosh_wall_clock_get_default ();
+  g_autofree char *date = phosh_wall_clock_local_date (clock);
+  int dx, dy;
+
+  gtk_label_set_label (GTK_LABEL (self->time), phosh_wall_clock_get_clock (clock, TRUE));
+  gtk_label_set_label (GTK_LABEL (self->date), date);
+
+  /* a slow walk around a small square, one step a minute */
+  self->step = (self->step + 1) % 16;
+  dx = ((int) (self->step % 4) - 2) * AOD_SHIFT / 2;
+  dy = ((int) (self->step / 4) - 2) * AOD_SHIFT / 2;
+  gtk_widget_set_margin_start (self->box, AOD_SHIFT + dx);
+  gtk_widget_set_margin_end (self->box, AOD_SHIFT - dx);
+  gtk_widget_set_margin_top (self->box, AOD_SHIFT + dy);
+  gtk_widget_set_margin_bottom (self->box, AOD_SHIFT - dy);
+}
+
+
+static void
+update_icons (PhoshAod *self)
+{
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  guint n;
+
+  gtk_container_foreach (GTK_CONTAINER (self->icons), (GtkCallback) gtk_widget_destroy, NULL);
+
+  n = g_list_model_get_n_items (self->sources);
+  for (guint i = 0; i < n && g_hash_table_size (seen) < 6; i++) {
+    g_autoptr (PhoshNotificationSource) source = g_list_model_get_item (self->sources, i);
+    g_autoptr (PhoshNotification) notification = NULL;
+    g_autofree char *key = NULL;
+    GIcon *icon;
+
+    if (!g_list_model_get_n_items (G_LIST_MODEL (source)))
+      continue;
+    notification = g_list_model_get_item (G_LIST_MODEL (source), 0);
+    icon = phosh_notification_get_app_icon (notification);
+    if (!icon)
+      continue;
+    key = g_icon_to_string (icon);
+    if (!key || g_hash_table_contains (seen, key))
+      continue;
+    g_hash_table_add (seen, g_steal_pointer (&key));
+    gtk_container_add (GTK_CONTAINER (self->icons), gtk_image_new_from_gicon (icon, GTK_ICON_SIZE_LARGE_TOOLBAR));
+  }
+  gtk_widget_show_all (self->icons);
+}
+
+
+static void
+phosh_aod_set_property (GObject *obj, guint prop_id, const GValue *value, GParamSpec *pspec)
+{
+  PhoshAod *self = PHOSH_AOD (obj);
+
+  switch (prop_id) {
+  case PROP_MONITOR:
+    g_set_object (&self->monitor, g_value_get_object (value));
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (obj, prop_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_aod_get_property (GObject *obj, guint prop_id, GValue *value, GParamSpec *pspec)
+{
+  PhoshAod *self = PHOSH_AOD (obj);
+
+  switch (prop_id) {
+  case PROP_MONITOR:
+    g_value_set_object (value, self->monitor);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (obj, prop_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_aod_constructed (GObject *object)
+{
+  PhoshAod *self = PHOSH_AOD (object);
+  PhoshWayland *wl = phosh_wayland_get_default ();
+  PhoshNotifyManager *nm = phosh_notify_manager_get_default ();
+  g_autoptr (GtkCssProvider) css = gtk_css_provider_new ();
+  GtkWidget *battery, *bottom;
+
+  if (self->monitor == NULL)
+    self->monitor = g_object_ref (phosh_shell_get_builtin_monitor (phosh_shell_get_default ()));
+
+  g_object_set (PHOSH_LAYER_SURFACE (self),
+                "layer-shell", phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                "wl-output", phosh_monitor_get_wl_output (self->monitor),
+                "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
+                "layer", ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                "kbd-interactivity", FALSE,
+                "exclusive-zone", -1,
+                "namespace", "phosh aod",
+                NULL);
+
+  G_OBJECT_CLASS (phosh_aod_parent_class)->constructed (object);
+
+  gtk_css_provider_load_from_data (css, aod_css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (), GTK_STYLE_PROVIDER (css),
+                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 10);
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "phosh-aod");
+
+  /* the clock sits a third down, as on Samsung's AOD; battery and app icons under it */
+  self->box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_widget_set_halign (self->box, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (self->box, GTK_ALIGN_START);
+  self->time = gtk_label_new (NULL);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->time), "aod-time");
+  self->date = gtk_label_new (NULL);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->date), "aod-date");
+  bottom = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  gtk_widget_set_halign (bottom, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_top (bottom, 18);
+  battery = phosh_battery_info_new ();
+  phosh_battery_info_set_show_detail (PHOSH_BATTERY_INFO (battery), TRUE);
+  self->icons = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  gtk_container_add (GTK_CONTAINER (bottom), battery);
+  gtk_container_add (GTK_CONTAINER (bottom), self->icons);
+  gtk_container_add (GTK_CONTAINER (self->box), self->time);
+  gtk_container_add (GTK_CONTAINER (self->box), self->date);
+  gtk_container_add (GTK_CONTAINER (self->box), bottom);
+
+  {
+    GtkWidget *align = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    GtkWidget *spacer = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+
+    gtk_widget_set_vexpand (spacer, FALSE);
+    gtk_widget_set_size_request (spacer, -1, 520);
+    gtk_container_add (GTK_CONTAINER (align), spacer);
+    gtk_container_add (GTK_CONTAINER (align), self->box);
+    gtk_container_add (GTK_CONTAINER (self), align);
+  }
+
+  g_signal_connect_object (phosh_wall_clock_get_default (), "notify::clock",
+                           G_CALLBACK (update_clock), self, G_CONNECT_SWAPPED);
+  self->sources = G_LIST_MODEL (g_object_ref (phosh_notify_manager_get_list (nm)));
+  g_signal_connect_object (self->sources, "items-changed",
+                           G_CALLBACK (update_icons), self, G_CONNECT_SWAPPED);
+
+  update_clock (self);
+  update_icons (self);
+  gtk_widget_show_all (GTK_WIDGET (self));
+}
+
+
+static void
+phosh_aod_dispose (GObject *object)
+{
+  PhoshAod *self = PHOSH_AOD (object);
+
+  g_clear_object (&self->sources);
+  g_clear_object (&self->monitor);
+
+  G_OBJECT_CLASS (phosh_aod_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_aod_class_init (PhoshAodClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->get_property = phosh_aod_get_property;
+  object_class->set_property = phosh_aod_set_property;
+  object_class->constructed = phosh_aod_constructed;
+  object_class->dispose = phosh_aod_dispose;
+
+  props[PROP_MONITOR] =
+    g_param_spec_object ("monitor", "", "",
+                         PHOSH_TYPE_MONITOR,
+                         G_PARAM_CONSTRUCT_ONLY | G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);
+
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+}
+
+
+static void
+phosh_aod_init (PhoshAod *self)
+{
+}
+
+
+PhoshAod *
+phosh_aod_new (PhoshMonitor *monitor)
+{
+  return g_object_new (PHOSH_TYPE_AOD, "monitor", monitor, NULL);
+}
