#!/usr/bin/python3
# org.mobian_project.CallAudio for the Galaxy S10e (replaces callaudiod).
#
# In a call the voice path runs in the ABOX firmware (exynos-callaudio, started
# by exynos-cpd), with PipeWire stopped, so callaudiod's PulseAudio switches do
# nothing. This service does the same jobs on the hardware directly:
#   EnableSpeaker  earpiece amp (RCV) <-> loudspeaker amp (SPK) digital volume
#   MuteMic        codec AIF1TX1/2 inputs None <-> IN3L/IN4L (the two mics)
#   volume keys    gpio-keys VOLUMEUP/DOWN step the active amp while in a call
import subprocess, threading

import evdev
from gi.repository import Gio, GLib

XML = '''<node><interface name="org.mobian_project.CallAudio">
<method name="SelectMode"><arg direction="in" name="mode" type="u"/><arg direction="out" name="success" type="b"/></method>
<property name="AudioMode" type="u" access="read"/>
<method name="EnableSpeaker"><arg direction="in" name="enable" type="b"/><arg direction="out" name="success" type="b"/></method>
<property name="SpeakerState" type="u" access="read"/>
<method name="MuteMic"><arg direction="in" name="mute" type="b"/><arg direction="out" name="success" type="b"/></method>
<property name="MicState" type="u" access="read"/>
</interface></node>'''
IFACE = 'org.mobian_project.CallAudio'
PATH = '/org/mobian_project/CallAudio'

# cs35l41 "Digital PCM Volume" 0..913 in 0.125 dB, 817 = 0 dB
NORMAL = {'RCV Digital PCM Volume': 761, 'SPK Digital PCM Volume': 769,
          'RCV Analog PCM Volume': 17}
CALL_RCV_ANALOG = 10            # stock in-call "PCM Gain 10"
VOL_MIN, VOL_MAX, VOL_STEP = 500, 913, 32   # 4 dB a press


def cset(name, val):
    subprocess.run(['amixer', '-q', '-c0', 'cset', "name=%s" % name, str(val)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class CallAudio:
    def __init__(self):
        self.mode = 0           # 1 = voice call
        self.speaker = False
        self.muted = False
        self.vol = {'RCV': 761, 'SPK': 769}     # in-call levels, kept per call
        self.conn = None
        self.lock = threading.Lock()

    # --- hardware
    def apply_route(self):
        on, off = ('SPK', 'RCV') if self.speaker else ('RCV', 'SPK')
        cset('%s Digital PCM Volume' % off, 0)
        cset('%s Digital PCM Volume' % on, self.vol[on])

    def apply_mic(self):
        for tx, src in (('AIF1TX1', 'IN3L'), ('AIF1TX2', 'IN4L')):
            cset('%s Input 1' % tx, 'None' if self.muted else src)

    def step_volume(self, up):
        with self.lock:
            if self.mode != 1:
                return
            amp = 'SPK' if self.speaker else 'RCV'
            v = self.vol[amp] + (VOL_STEP if up else -VOL_STEP)
            self.vol[amp] = max(VOL_MIN, min(VOL_MAX, v))
            cset('%s Digital PCM Volume' % amp, self.vol[amp])

    # --- D-Bus
    def changed(self, **props):
        if not self.conn:
            return
        self.conn.emit_signal(None, PATH, 'org.freedesktop.DBus.Properties',
                              'PropertiesChanged', GLib.Variant('(sa{sv}as)', (
                                  IFACE, {k: GLib.Variant('u', v) for k, v in props.items()}, [])))

    def call(self, conn, sender, path, iface, method, params, inv):
        arg = params.unpack()[0]
        with self.lock:
            if method == 'SelectMode':
                if arg not in (0, 1):
                    inv.return_dbus_error('org.freedesktop.DBus.Error.InvalidArgs', 'mode')
                    return
                self.mode = arg
                if arg == 1:
                    self.vol = {'RCV': 761, 'SPK': 769}
                    cset('RCV Analog PCM Volume', CALL_RCV_ANALOG)
                    self.apply_route()
                    self.apply_mic()
                else:
                    self.speaker = self.muted = False
                    self.apply_mic()
                    for k, v in NORMAL.items():
                        cset(k, v)
                self.changed(AudioMode=self.mode, SpeakerState=int(self.speaker),
                             MicState=int(not self.muted))
            elif method == 'EnableSpeaker':
                self.speaker = bool(arg)
                if self.mode == 1:
                    self.apply_route()
                self.changed(SpeakerState=int(self.speaker))
            elif method == 'MuteMic':
                self.muted = bool(arg)
                self.apply_mic()
                self.changed(MicState=int(not self.muted))
        inv.return_value(GLib.Variant('(b)', (True,)))

    def get(self, conn, sender, path, iface, prop):
        return GLib.Variant('u', {'AudioMode': self.mode,
                                  'SpeakerState': int(self.speaker),
                                  'MicState': int(not self.muted)}[prop])


def keys(ca):
    dev = next(evdev.InputDevice(p) for p in evdev.list_devices()
               if evdev.InputDevice(p).name == 'gpio-keys')
    for ev in dev.read_loop():
        if ev.type == evdev.ecodes.EV_KEY and ev.value in (1, 2):    # press, repeat
            if ev.code in (evdev.ecodes.KEY_VOLUMEUP, evdev.ecodes.KEY_VOLUMEDOWN):
                ca.step_volume(ev.code == evdev.ecodes.KEY_VOLUMEUP)


def main():
    ca = CallAudio()
    node = Gio.DBusNodeInfo.new_for_xml(XML)

    def on_bus(conn, name):
        ca.conn = conn
        conn.register_object(PATH, node.interfaces[0], ca.call, ca.get, None)

    Gio.bus_own_name(Gio.BusType.SESSION, IFACE, Gio.BusNameOwnerFlags.REPLACE,
                     on_bus, None, lambda *a: loop.quit())
    threading.Thread(target=keys, args=(ca,), daemon=True).start()
    loop = GLib.MainLoop()
    loop.run()


if __name__ == '__main__':
    main()
