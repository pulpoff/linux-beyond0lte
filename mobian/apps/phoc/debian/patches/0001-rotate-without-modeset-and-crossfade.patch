+/*
+ * An output that stays on in the mode it has (a rotation, a new scale) needs no modeset: setting
+ * "enabled" and the same mode again makes wlroots do one anyway, and a DSI panel goes dark for it.
+ * Transform and scale are applied when rendering. Only for a change to a running output: the first
+ * commit (at startup) may well need the modeset. Returns whether the state was trimmed.
+ */
+static gboolean
+phoc_output_state_skip_modeset (PhocOutput *self, struct wlr_output_state *pending)
+{
+  struct wlr_output *wlr_output = self->wlr_output;
+
+  if (!wlr_output->enabled || !(pending->committed & WLR_OUTPUT_STATE_ENABLED) || !pending->enabled)
+    return FALSE;
+
+  if ((pending->committed & WLR_OUTPUT_STATE_MODE) &&
+      !(pending->mode_type == WLR_OUTPUT_STATE_MODE_FIXED && pending->mode == wlr_output->current_mode))
+    return FALSE;
+
+  pending->committed &= ~(WLR_OUTPUT_STATE_ENABLED | WLR_OUTPUT_STATE_MODE);
+  pending->allow_reconfiguration = false;
+  return TRUE;
+}
