+/* Neo: de.yesman.neo aod, when the launcher's schema is installed */
+static gboolean
+neo_aod_enabled (void)
+{
+  static GSettings *settings;
+  static gboolean looked;
+
+  if (!looked) {
+    g_autoptr (GSettingsSchema) schema = NULL;
+
+    looked = TRUE;
+    schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (), "de.yesman.neo", TRUE);
+    if (schema && g_settings_schema_has_key (schema, "aod"))
+      settings = g_settings_new ("de.yesman.neo");
+  }
+
+  return settings && g_settings_get_boolean (settings, "aod");
+}
