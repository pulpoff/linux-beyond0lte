+/*
+ * A mobile-terminated call is announced while the modem still has it in
+ * "setup", and only takes an answer once it moves on to "incoming" a moment
+ * later: until then Answer Call fails with IncompatibleState. Failing the
+ * accept there made the call look ended to the user while the network kept
+ * it, and it then came back as a second incoming call ("answer twice").
+ * So an IncompatibleState answer is retried for a few seconds instead.
+ */
+#define ANSWER_RETRY_INTERVAL_MS 250
+#define ANSWER_RETRY_MAX         20
+
+typedef struct {
+    QmiClientVoice *client;
+    guint8          call_id;
+    guint           attempts;
+} AcceptContext;
+
+static void
+accept_context_free (AcceptContext *ctx)
+{
+    g_object_unref (ctx->client);
+    g_slice_free (AcceptContext, ctx);
+}
+
+static void answer_call (GTask *task);
+
+static gboolean
+answer_call_retry_cb (GTask *task)
+{
+    answer_call (task);
+    return G_SOURCE_REMOVE;
+}
+
 static void
 voice_answer_call_ready (QmiClientVoice *client,
                          GAsyncResult   *res,
                          GTask          *task)
 {
     QmiMessageVoiceAnswerCallOutput *output;
+    AcceptContext *ctx = g_task_get_task_data (task);
     GError *error = NULL;
 
     output = qmi_client_voice_answer_call_finish (client, res, &error);
@@ -193,6 +227,16 @@
         g_prefix_error (&error, "QMI operation failed: ");
         g_task_return_error (task, error);
     } else if (!qmi_message_voice_answer_call_output_get_result (output, &error)) {
+        if (g_error_matches (error, QMI_PROTOCOL_ERROR, QMI_PROTOCOL_ERROR_INCOMPATIBLE_STATE) &&
+            ctx->attempts < ANSWER_RETRY_MAX) {
+            mm_obj_dbg (g_task_get_source_object (task),
+                        "call %u not ready to be answered yet, retrying (%u)",
+                        ctx->call_id, ctx->attempts);
+            g_error_free (error);
+            qmi_message_voice_answer_call_output_unref (output);
+            g_timeout_add (ANSWER_RETRY_INTERVAL_MS, (GSourceFunc) answer_call_retry_cb, task);
+            return;
+        }
         g_prefix_error (&error, "Couldn't accept call: ");
         g_task_return_error (task, error);
