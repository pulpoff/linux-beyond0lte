+	/*
+	 * The frame rates the camera can run at, from FrameDurationLimits. Without a framerate in the format a
+	 * consumer whose caps carry one (an encoder: v4l2h264enc) failed to negotiate at all ("no more input
+	 * formats"), and the camera ran at whatever rate its mode defaulted to.
+	 */
+	if (auto fd = impl->camera->controls().find(&libcamera::controls::FrameDurationLimits);
+	    fd != impl->camera->controls().end()) {
+		const ControlInfo &ci = fd->second;
+		const int64_t minUs = ci.min().get<int64_t>(), maxUs = ci.max().get<int64_t>();
+		const int64_t defUs = ci.def().isArray() || ci.def().isNone() ? minUs : ci.def().get<int64_t>();
+		if (minUs > 0 && maxUs >= minUs) {
+			auto fps = [](int64_t us) {
+				return SPA_FRACTION(std::max<uint32_t>(1, (uint32_t)((1000000 + us / 2) / us)), 1);
+			};
+			struct spa_fraction def = fps(defUs), lo = fps(maxUs), hi = fps(minUs);
+			spa_pod_builder_prop(&b, SPA_FORMAT_VIDEO_framerate, 0);
+			spa_pod_builder_push_choice(&b, &f[1], SPA_CHOICE_Range, 0);
+			spa_pod_builder_fraction(&b, def.num, def.denom);
+			spa_pod_builder_fraction(&b, lo.num, lo.denom);
+			spa_pod_builder_fraction(&b, hi.num, hi.denom);
+			spa_pod_builder_pop(&b, &f[1]);
+		}
+	}
