   GSettings          *lockscreen_settings;
 
+  /* Neo: the pattern lock (de.yesman.neo lock-type = 'pattern'); the dots join into the password */
+  GSettings          *neo_settings;
+  GtkWidget          *pattern;
+  GtkGesture         *pattern_drag;
+  char                pattern_seq[10];
+  guint               pattern_len;
+  double              pattern_x, pattern_y;
+  gboolean            pattern_active;
+  gboolean            pattern_error;
+  guint               pattern_clear_id;
+
   struct {
