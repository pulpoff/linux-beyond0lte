+/* Neo: touchscreens that wake on a double tap (s6sy761's wake_gesture) follow the blanked state */
+static void
+neo_set_wake_gesture (gboolean on)
+{
+  const char *base = "/sys/bus/i2c/devices";
+  g_autoptr (GDir) dir = g_dir_open (base, 0, NULL);
+  const char *name;
+
+  while (dir && (name = g_dir_read_name (dir))) {
+    g_autofree char *path = g_build_filename (base, name, "wake_gesture", NULL);
+    g_autoptr (GError) err = NULL;
+
+    if (!g_file_test (path, G_FILE_TEST_EXISTS))
+      continue;
+    if (!g_file_set_contents_full (path, on ? "1" : "0", 1, G_FILE_SET_CONTENTS_NONE, 0666, &err))
+      g_warning ("Failed to set %s: %s", path, err->message);
+  }
+}
+
+
+static void
+neo_blanked_changed (PhoshShell *self, PhoshMonitor *monitor, gboolean blanked)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  gboolean dt2w = FALSE;
+
+  if (blanked && monitor->aod) {
+    if (!priv->aod) {
+      priv->aod = phosh_aod_new (monitor);
+      gtk_widget_show (GTK_WIDGET (priv->aod));
+    }
+  } else {
+    g_clear_pointer (&priv->aod, phosh_cp_widget_destroy);
+  }
+
+  if (!priv->neo_settings) {
+    g_autoptr (GSettingsSchema) schema = NULL;
+
+    schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (), "de.yesman.neo", TRUE);
+    if (schema && g_settings_schema_has_key (schema, "double-tap-wake"))
+      priv->neo_settings = g_settings_new ("de.yesman.neo");
+  }
+  if (priv->neo_settings)
+    dt2w = g_settings_get_boolean (priv->neo_settings, "double-tap-wake");
+
+  neo_set_wake_gesture (blanked && dt2w);
+}
