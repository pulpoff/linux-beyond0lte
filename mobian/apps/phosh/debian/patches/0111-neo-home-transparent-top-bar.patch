+/* Neo: its home screen came or went; over it the top bar is clear, as over the lock screen */
+void
+phosh_shell_neo_home_shown_changed (PhoshShell *self)
+{
+  g_return_if_fail (PHOSH_IS_SHELL (self));
+
+  update_top_bar_transparency (self);
