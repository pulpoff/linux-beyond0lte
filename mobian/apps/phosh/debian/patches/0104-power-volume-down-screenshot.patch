+static gboolean
+on_screenshot_combo_timeout (gpointer data)
+{
+  PhoshScreenshotManager *screenshot_manager;
+
+  screenshot_manager = phosh_shell_get_screenshot_manager (phosh_shell_get_default ());
+  if (screenshot_manager)
+    phosh_screenshot_manager_take_screenshot (screenshot_manager, NULL, NULL, TRUE, FALSE);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+screenshot_combo (PhoshScreenSaverManager *self)
+{
+  self->screenshot_combo = TRUE;
+  g_clear_handle_id (&self->long_press_id, g_source_remove);
+  /* the volume key's popup goes first (and stays away: the volume daemon may ask for it after us), then the
+   * picture once the popup is off the screen */
+  phosh_shell_suppress_osd (phosh_shell_get_default (), 1500);
+  g_timeout_add (250, on_screenshot_combo_timeout, NULL);
+}
+
+
+/**
+ * phosh_screen_saver_manager_volume_down_pressed:
+ * @self: The screen saver manager
+ *
+ * Volume down was pressed: with the power button held (or pressed right after it) that is a screenshot.
+ */
+void
+phosh_screen_saver_manager_volume_down_pressed (PhoshScreenSaverManager *self)
+{
+  g_return_if_fail (PHOSH_IS_SCREEN_SAVER_MANAGER (self));
+
+  self->vol_down_time = g_get_monotonic_time ();
+  if (self->power_held && !self->screenshot_combo)
+    screenshot_combo (self);
+}
+
