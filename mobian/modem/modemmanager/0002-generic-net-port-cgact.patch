 static void
+cgcontrdp_net_ready (MMBaseModem  *modem,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    MMBroadbandBearer                *self;
+    DetailedConnectContext           *ctx;
+    const gchar                      *response;
+    GError                           *error = NULL;
+    g_autofree gchar                 *address = NULL;
+    g_autofree gchar                 *subnet = NULL;
+    g_autofree gchar                 *gateway = NULL;
+    g_autofree gchar                 *dns1 = NULL;
+    g_autofree gchar                 *dns2 = NULL;
+    const gchar                      *dns[3] = { NULL, NULL, NULL };
+    guint                             n = 0;
+    g_autoptr(MMBearerConnectResult)  result = NULL;
+    g_autoptr(MMBearerIpConfig)       ipv4_config = NULL;
+    g_autoptr(MMBearerIpConfig)       ipv6_config = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response ||
+        !mm_3gpp_parse_cgcontrdp_response (response, NULL, NULL, NULL, &address, &subnet,
+                                           &gateway, &dns1, &dns2, &error)) {
+        mm_obj_warn (self, "no static IP settings, falling back to DHCP: %s", error->message);
+        g_clear_error (&error);
+    }
+
+    if (ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV4 | MM_BEARER_IP_FAMILY_IPV4V6)) {
+        ipv4_config = mm_bearer_ip_config_new ();
+        if (address) {
+            mm_bearer_ip_config_set_method (ipv4_config, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (ipv4_config, address);
+            mm_bearer_ip_config_set_prefix (ipv4_config, subnet ? mm_netmask_to_cidr (subnet) : 32);
+            if (gateway && !g_str_equal (gateway, "0.0.0.0"))
+                mm_bearer_ip_config_set_gateway (ipv4_config, gateway);
+            if (dns1 && !g_str_equal (dns1, "0.0.0.0"))
+                dns[n++] = dns1;
+            if (dns2 && !g_str_equal (dns2, "0.0.0.0"))
+                dns[n++] = dns2;
+            if (n)
+                mm_bearer_ip_config_set_dns (ipv4_config, dns);
+        } else
+            mm_bearer_ip_config_set_method (ipv4_config, MM_BEARER_IP_METHOD_DHCP);
+    }
+    if (ctx->ip_family & (MM_BEARER_IP_FAMILY_IPV6 | MM_BEARER_IP_FAMILY_IPV4V6)) {
+        /* the network's router advertisements configure IPv6 */
+        ipv6_config = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (ipv6_config, MM_BEARER_IP_METHOD_DHCP);
+    }
+    if (!ipv4_config && !ipv6_config) {
+        ipv4_config = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (ipv4_config, MM_BEARER_IP_METHOD_DHCP);
+    }
+
+    result = mm_bearer_connect_result_new (ctx->data, ipv4_config, ipv6_config);
+    mm_bearer_connect_result_set_profile_id (result, self->priv->profile_id);
+    g_task_return_pointer (task, g_steal_pointer (&result), (GDestroyNotify)mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
