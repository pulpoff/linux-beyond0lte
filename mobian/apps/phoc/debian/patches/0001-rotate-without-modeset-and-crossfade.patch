   if (self->output == NULL || self->output != ctx->output)
     return;
 
+  if (self->snapshot) {
+    struct wlr_output *wlr_output = self->output->wlr_output;
+    float alpha = phoc_color_rect_get_alpha (self->color_rect);
+    float p = 1.0f - alpha;      /* 0 while raised, eased to 1 while lowering */
+    int W = wlr_output->width, H = wlr_output->height;
+    int iw = self->snapshot->width, ih = self->snapshot->height;
+    double fit, fill, s;
+
+    /* the old frame as the user now holds the phone: turned upright (in buffer pixels its sides swap) */
+    if (self->snapshot_transform % 2) {
+      int t = iw;
+      iw = ih;
+      ih = t;
+    }
+    /* first fitted inside the turned screen, then growing to fill it while it fades into the new layout */
+    fit = MIN ((double) W / iw, (double) H / ih);
+    fill = MAX ((double) W / iw, (double) H / ih);
+    s = fit + (fill - fit) * p;
+
+    wlr_render_pass_add_rect (ctx->render_pass, &(struct wlr_render_rect_options){
+        .box = { 0, 0, W, H },
+        .color = { 0, 0, 0, alpha },
