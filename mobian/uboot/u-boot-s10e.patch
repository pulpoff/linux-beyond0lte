+s10e_stay=run s10e_load &&
+	setenv bootargs "${s10e_args_verbose} s10e.stay" &&
+	booti ${kernel_addr_r} ${ramdisk_addr_r}:${rd_size} ${fdtcontroladdr}
+
 fastbootcmd=echo "Fastboot Mode";
 	fastboot -l $fastboot_addr_r usb 0
 
-reboot_recovery=mw.l 0x15860810 0xff; 
-	mw.l 0x1586080c 0x12345674;
-	reset
-
