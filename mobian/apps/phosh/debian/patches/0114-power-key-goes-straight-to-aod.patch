 /**
+ * phosh_lockscreen_set_hidden:
+ * @self: The `PhoshLockscreen`
+ * @hidden: Whether the lock screen and its background are fully transparent
+ *
+ * Neo: a lock screen made on the way into the always-on display stays hidden under it, so the screen goes
+ * from unlocked straight to the AOD. It still takes the keyboard and the touches it gets.
+ */
+void
+phosh_lockscreen_set_hidden (PhoshLockscreen *self, gboolean hidden)
+{
+  PhoshLockscreenPrivate *priv;
+
+  g_return_if_fail (PHOSH_IS_LOCKSCREEN (self));
+  priv = phosh_lockscreen_get_instance_private (self);
+
+  phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (self), hidden ? 0.0 : 1.0);
+  if (priv->background)
+    phosh_layer_surface_set_alpha (PHOSH_LAYER_SURFACE (priv->background), hidden ? 0.0 : 1.0);
+}
+
