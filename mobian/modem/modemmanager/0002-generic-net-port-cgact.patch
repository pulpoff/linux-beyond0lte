 /*****************************************************************************/
+/* Net-port modems driven by plain 3GPP commands
+ *
+ * Some modems expose an AT port and a raw-IP net port but no QMI/MBIM control
+ * channel (e.g. a shared-memory CP whose own IPC is bridged to AT). The generic
+ * logic can't use their net port and would dial PPP on the AT port instead.
+ * When the net port carries the udev property ID_MM_NET_CGACT=1, connect with
+ * +CGACT=1,<cid> on the primary port, take the static IP settings from
+ * +CGCONTRDP=<cid>, and disconnect with +CGACT=0,<cid>.
+ */
+
+static MMPort *
+peek_cgact_net_port (MMBaseModem *modem)
+{
+    MMPort         *net;
+    MMKernelDevice *kernel_device;
+
+    net = mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET);
+    if (!net)
+        return NULL;
+    kernel_device = mm_port_peek_kernel_device (net);
+    if (!kernel_device ||
+        !mm_kernel_device_get_global_property_as_boolean (kernel_device, "ID_MM_NET_CGACT"))
+        return NULL;
+    return net;
+}
