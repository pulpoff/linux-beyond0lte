#include <dt-bindings/clock/exynos9820.h>
#include <dt-bindings/clock/samsung,exynos9820-acpm.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/exynos9820.h>

/ {
	compatible = "samsung,exynos9820";
	#address-cells = <2>;
	#size-cells = <1>;

	interrupt-parent = <&gic>;

	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_aud;
		pinctrl2 = &pinctrl_cmgp;
		pinctrl3 = &pinctrl_fsys0;
		pinctrl4 = &pinctrl_fsys1;
		pinctrl5 = &pinctrl_peric0;
		pinctrl6 = &pinctrl_peric1;
		pinctrl7 = &pinctrl_vts;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu6>;
				};
				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL0>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&ananke_cpu_sleep>;
			capacity-dmips-mhz = <272>;
			dynamic-power-coefficient = <160>;
			operating-points-v2 = <&cpucl0_opp_table>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x1>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL0>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&ananke_cpu_sleep>;
			capacity-dmips-mhz = <272>;
			dynamic-power-coefficient = <160>;
			operating-points-v2 = <&cpucl0_opp_table>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x2>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL0>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&ananke_cpu_sleep>;
			capacity-dmips-mhz = <272>;
			dynamic-power-coefficient = <160>;
			operating-points-v2 = <&cpucl0_opp_table>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x3>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL0>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&ananke_cpu_sleep>;
			capacity-dmips-mhz = <272>;
			dynamic-power-coefficient = <160>;
			operating-points-v2 = <&cpucl0_opp_table>;
		};

		cpu4: cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x4>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL1>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&prometheus_cpu_sleep>;
			capacity-dmips-mhz = <531>;
			dynamic-power-coefficient = <320>;
			operating-points-v2 = <&cpucl1_opp_table>;
		};

		cpu5: cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x5>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL1>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&prometheus_cpu_sleep>;
			capacity-dmips-mhz = <531>;
			dynamic-power-coefficient = <320>;
			operating-points-v2 = <&cpucl1_opp_table>;
		};

		cpu6: cpu@100 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m4";
			reg = <0x100>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL2>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&cheetah_cpu_sleep>;
			capacity-dmips-mhz = <785>;
			dynamic-power-coefficient = <760>;
			operating-points-v2 = <&cpucl2_opp_table>;
		};

		cpu7: cpu@101 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m4";
			reg = <0x101>;
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL2>;
			#cooling-cells = <2>;
			enable-method = "psci";
			cpu-idle-states = <&cheetah_cpu_sleep>;
			capacity-dmips-mhz = <785>;
			dynamic-power-coefficient = <760>;
			operating-points-v2 = <&cpucl2_opp_table>;
		};

		idle-states {
			entry-method = "psci";

			ananke_cpu_sleep: cpu-ananke-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x0010000>;
				local-timer-stop;
				entry-latency-us = <70>;
				exit-latency-us = <160>;
				min-residency-us = <2000>;
				status = "disabled";
			};

			prometheus_cpu_sleep: cpu-prometheus-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x0010000>;
				local-timer-stop;
				entry-latency-us = <150>;
				exit-latency-us = <190>;
				min-residency-us = <2500>;
				status = "disabled";
			};

			cheetah_cpu_sleep: cpu-cheetah-sleep {
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x0010000>;
				local-timer-stop;
				entry-latency-us = <235>;
				exit-latency-us = <220>;
				min-residency-us = <3500>;
				status = "disabled";
			};
		};
	};

	cpucl0_opp_table: opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-442000000 {
			opp-hz = /bits/ 64 <442000000>;
			opp-microvolt = <581250>;
			clock-latency-ns = <500000>;
		};

		opp-546000000 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <612500>;
			clock-latency-ns = <500000>;
		};

		opp-650000000 {
			opp-hz = /bits/ 64 <650000000>;
			opp-microvolt = <631250>;
			clock-latency-ns = <500000>;
		};

		opp-806000000 {
			opp-hz = /bits/ 64 <806000000>;
			opp-microvolt = <675000>;
			clock-latency-ns = <500000>;
		};

		opp-949000000 {
			opp-hz = /bits/ 64 <949000000>;
			opp-microvolt = <712500>;
			clock-latency-ns = <500000>;
		};

		opp-1053000000 {
			opp-hz = /bits/ 64 <1053000000>;
			opp-microvolt = <743750>;
			clock-latency-ns = <500000>;
		};

		opp-1157000000 {
			opp-hz = /bits/ 64 <1157000000>;
			opp-microvolt = <775000>;
			clock-latency-ns = <500000>;
		};

		opp-1300000000 {
			opp-hz = /bits/ 64 <1300000000>;
			opp-microvolt = <818750>;
			clock-latency-ns = <500000>;
		};

		opp-1456000000 {
			opp-hz = /bits/ 64 <1456000000>;
			opp-microvolt = <868750>;
			clock-latency-ns = <500000>;
		};

		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt = <918750>;
			clock-latency-ns = <500000>;
		};

		opp-1742000000 {
			opp-hz = /bits/ 64 <1742000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <500000>;
		};

		opp-1846000000 {
			opp-hz = /bits/ 64 <1846000000>;
			opp-microvolt = <1050000>;
			clock-latency-ns = <500000>;
		};

		opp-1950000000 {
			opp-hz = /bits/ 64 <1950000000>;
			opp-microvolt = <1093750>;
			clock-latency-ns = <500000>;
		};
	};

	cpucl1_opp_table: opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-507000000 {
			opp-hz = /bits/ 64 <507000000>;
			opp-microvolt = <587500>;
			clock-latency-ns = <500000>;
		};

		opp-650000000 {
			opp-hz = /bits/ 64 <650000000>;
			opp-microvolt = <606250>;
			clock-latency-ns = <500000>;
		};

		opp-754000000 {
			opp-hz = /bits/ 64 <754000000>;
			opp-microvolt = <631250>;
			clock-latency-ns = <500000>;
		};

		opp-845000000 {
			opp-hz = /bits/ 64 <845000000>;
			opp-microvolt = <650000>;
			clock-latency-ns = <500000>;
		};

		opp-962000000 {
			opp-hz = /bits/ 64 <962000000>;
			opp-microvolt = <662500>;
			clock-latency-ns = <500000>;
		};

		opp-1066000000 {
			opp-hz = /bits/ 64 <1066000000>;
			opp-microvolt = <681250>;
			clock-latency-ns = <500000>;
		};

		opp-1222000000 {
			opp-hz = /bits/ 64 <1222000000>;
			opp-microvolt = <725000>;
			clock-latency-ns = <500000>;
		};

		opp-1404000000 {
			opp-hz = /bits/ 64 <1404000000>;
			opp-microvolt = <756250>;
			clock-latency-ns = <500000>;
		};

		opp-1508000000 {
			opp-hz = /bits/ 64 <1508000000>;
			opp-microvolt = <781250>;
			clock-latency-ns = <500000>;
		};

		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt = <793750>;
			clock-latency-ns = <500000>;
		};

		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			opp-microvolt = <818750>;
			clock-latency-ns = <500000>;
		};

		opp-1794000000 {
			opp-hz = /bits/ 64 <1794000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <500000>;
		};

		opp-1898000000 {
			opp-hz = /bits/ 64 <1898000000>;
			opp-microvolt = <893750>;
			clock-latency-ns = <500000>;
		};

		opp-2002000000 {
			opp-hz = /bits/ 64 <2002000000>;
			opp-microvolt = <918750>;
			clock-latency-ns = <500000>;
		};

		opp-2106000000 {
			opp-hz = /bits/ 64 <2106000000>;
			opp-microvolt = <956250>;
			clock-latency-ns = <500000>;
		};

		opp-2210000000 {
			opp-hz = /bits/ 64 <2210000000>;
			opp-microvolt = <1006250>;
			clock-latency-ns = <500000>;
		};

		opp-2314000000 {
			opp-hz = /bits/ 64 <2314000000>;
			opp-microvolt = <1056250>;
			clock-latency-ns = <500000>;
		};
	};

	cpucl2_opp_table: opp-table-2 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-520000000 {
			opp-hz = /bits/ 64 <520000000>;
			opp-microvolt = <587500>;
			clock-latency-ns = <500000>;
		};

		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <600000>;
			clock-latency-ns = <500000>;
		};

		opp-728000000 {
			opp-hz = /bits/ 64 <728000000>;
			opp-microvolt = <606250>;
			clock-latency-ns = <500000>;
		};

		opp-819000000 {
			opp-hz = /bits/ 64 <819000000>;
			opp-microvolt = <618750>;
			clock-latency-ns = <500000>;
		};

		opp-936000000 {
			opp-hz = /bits/ 64 <936000000>;
			opp-microvolt = <637500>;
			clock-latency-ns = <500000>;
		};

		opp-1040000000 {
			opp-hz = /bits/ 64 <1040000000>;
			opp-microvolt = <643750>;
			clock-latency-ns = <500000>;
		};

		opp-1144000000 {
			opp-hz = /bits/ 64 <1144000000>;
			opp-microvolt = <675000>;
			clock-latency-ns = <500000>;
		};

		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			opp-microvolt = <687500>;
			clock-latency-ns = <500000>;
		};

		opp-1378000000 {
			opp-hz = /bits/ 64 <1378000000>;
			opp-microvolt = <706250>;
			clock-latency-ns = <500000>;
		};

		opp-1456000000 {
			opp-hz = /bits/ 64 <1456000000>;
			opp-microvolt = <718750>;
			clock-latency-ns = <500000>;
		};

		opp-1560000000 {
			opp-hz = /bits/ 64 <1560000000>;
			opp-microvolt = <743750>;
			clock-latency-ns = <500000>;
		};

		opp-1664000000 {
			opp-hz = /bits/ 64 <1664000000>;
			opp-microvolt = <768750>;
			clock-latency-ns = <500000>;
		};

		opp-1820000000 {
			opp-hz = /bits/ 64 <1820000000>;
			opp-microvolt = <793750>;
			clock-latency-ns = <500000>;
		};

		opp-1976000000 {
			opp-hz = /bits/ 64 <1976000000>;
			opp-microvolt = <837500>;
			clock-latency-ns = <500000>;
		};

		opp-2080000000 {
			opp-hz = /bits/ 64 <2080000000>;
			opp-microvolt = <868750>;
			clock-latency-ns = <500000>;
		};

		opp-2236000000 {
			opp-hz = /bits/ 64 <2236000000>;
			opp-microvolt = <906250>;
			clock-latency-ns = <500000>;
		};

		opp-2340000000 {
			opp-hz = /bits/ 64 <2340000000>;
			opp-microvolt = <931250>;
			clock-latency-ns = <500000>;
		};

		opp-2470000000 {
			opp-hz = /bits/ 64 <2470000000>;
			opp-microvolt = <987500>;
			clock-latency-ns = <500000>;
		};

		opp-2530000000 {
			opp-hz = /bits/ 64 <2530000000>;
			opp-microvolt = <1018750>;
			clock-latency-ns = <500000>;
		};

		/*
		 * Mongoose cores can go all the way to 2.73GHz,
		 * but trying to run all 8 cores at max frequency trips hw
		 * thermal/overcurrent protection faster than the TMU can react
		 */
	};

	firmware {
		acpm_ipc: power-management {
			compatible = "samsung,exynos9820-acpm-ipc";
			#clock-cells = <1>;

			/* Provide boot defaults since FREQ_GET is broken */
			assigned-clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_MIF>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_INT>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL0>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL1>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CPUCL2>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_NPU>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_DISP>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_SCORE>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_AUD>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVS_CP>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_G3D>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_INTCAM>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_CAM>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_IVA>,
					  <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_MFC>;
			assigned-clock-rates = <2093000000>,
					       <534000000>,
					       <1053000000>,
					       <1222000000>,
					       <1378000000>,
					       <167000000>,
					       <534000000>,
					       <25000000>,
					       <295000000>,
					       <1066000000>,
					       <156000000>,
					       <630000000>,
					       <650000000>,
					       <56000000>,
					       <134000000>;

			mboxes = <&ap2apm_mailbox>;
			shmem = <&apm_sram>;
		};
	};

	oscclk: osc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-output-names = "oscclk";
	};

	/* TODO: A55 PMU */
	/* TODO: A75 PMU */
	/* TODO: Mongoose M4 PMU */

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;

		interrupt-affinity = <&cpu0>,
				     <&cpu1>,
				     <&cpu2>,
				     <&cpu3>;
	};

	pmu-a75 {
		compatible = "arm,cortex-a75-pmu";
		interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>;

		interrupt-affinity = <&cpu4>,
				     <&cpu5>;
	};

	pmu-mongoose-m4 {
		compatible = "samsung,mongoose-pmu";
		interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>;

		interrupt-affinity = <&cpu6>,
				     <&cpu7>;
	};

	psci {
		/* PSCI advertises 0.2+ but AFFINITY_INFO is broken */
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	/*
	 * Stock gpu_dvfs_table. ACPM sets the G3D voltage itself for each
	 * rate (EXYNOS9820_CLK_ACPM_DVFS_G3D), so no opp-microvolt.
	 */
	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-156000000 {
			opp-hz = /bits/ 64 <156000000>;
		};
		opp-200000000 {
			opp-hz = /bits/ 64 <200000000>;
		};
		opp-260000000 {
			opp-hz = /bits/ 64 <260000000>;
		};
		opp-325000000 {
			opp-hz = /bits/ 64 <325000000>;
		};
		opp-377000000 {
			opp-hz = /bits/ 64 <377000000>;
		};
		opp-433000000 {
			opp-hz = /bits/ 64 <433000000>;
		};
		opp-572000000 {
			opp-hz = /bits/ 64 <572000000>;
		};
		opp-650000000 {
			opp-hz = /bits/ 64 <650000000>;
		};
		opp-702000000 {
			opp-hz = /bits/ 64 <702000000>;
		};
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x0 0x20000000>;

		flexpmu_dbg: flexpmu-dbg@204bc00 {
			compatible = "samsung,exynos9820-flexpmu-dbg";
			reg = <0x0204bc00 0x400>,
			      <0x15950000 0x100>;
			reg-names = "data", "rtc";
		};

#if 0
		chipid@10000000 {
			compatible = "samsung,exynos9810-chipid",
				     "samsung,exynos850-chipid";
			reg = <0x10000000 0x100>;
		};
#endif
		cmu_peris: clock-controller@10020000 {
			compatible = "samsung,exynos9820-cmu-peris";
			reg = <0x10020000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_PERIS_BUS>;
			samsung,sysreg = <&sysreg_peris>;
		};

		sysreg_peris: syscon@10030000 {
			compatible = "samsung,exynos9820-peris-sysreg", "syscon";
			reg = <0x10030000 0x10000>;
			clocks = <&cmu_peris CLK_GOUT_PERIS_SYSREG_PERIS_PCLK>;
		};

		timer@10040000 {
			compatible = "samsung,exynos4210-mct";
			reg = <0x10040000 0x800>;
			clocks = <&oscclk>,
				 <&cmu_peris CLK_GOUT_PERIS_MCT_PCLK>;
			clock-names = "fin_pll",
				      "mct";
			interrupts = <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 468 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 469 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 470 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 471 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 473 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 474 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 475 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 477 IRQ_TYPE_LEVEL_HIGH>;
		};

		tmu_top: thermal-sensor@10090000 {
			compatible = "samsung,exynos9820-tmu-top";
			reg = <0x10090000 0x800>;
			clocks = <&cmu_peris CLK_GOUT_PERIS_TMU_TOP_PCLK>,
				 <&cmu_peris CLK_GOUT_PERIS_TMU_SUB_PCLK>;
			interrupts = <GIC_SPI 478 IRQ_TYPE_LEVEL_HIGH>;
			samsung,acpm-ipc = <&acpm_ipc>;
			#thermal-sensor-cells = <1>;
		};

		gic: interrupt-controller@10100000 {
			compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";

			#interrupt-cells = <3>;
			#address-cells = <0>;

			interrupt-controller;
			reg = <0x10101000 0x1000>,
			      <0x10102000 0x1000>,
			      <0x10104000 0x2000>,
			      <0x10106000 0x2000>;
			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) |
						 IRQ_TYPE_LEVEL_HIGH)>;
		};

		cmu_peric0: clock-controller@10400000 {
			compatible = "samsung,exynos9820-cmu-peric0";
			reg = <0x10400000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus",
				      "ip";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_BUS>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_IP>;
			samsung,sysreg = <&sysreg_peric0>;
		};

		sysreg_peric0: syscon@10420000 {
			compatible = "samsung,exynos9820-peric0-sysreg", "syscon";
			reg = <0x10420000 0x10000>;
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_SYSREG_PERIC0_PCLK>;
		};

		pinctrl_peric0: pinctrl@10430000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x10430000 0x1000>;
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_GPIO_PERIC0_PCLK>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>;
		};

		serial0: serial@10440000 {
			compatible = "samsung,exynos7870-uart",
				     "samsung,exynos8895-uart";
			reg = <0x10440000 0x100>;
			interrupts = <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>;

#if 0
			pinctrl-names = "default";
			pinctrl-0 = <&uart0_bus>;
#endif

			clock-names = "uart",
				      "clk_uart_baud0";
			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_UART_DBG_PCLK>,
				 <&cmu_peric0 CLK_GOUT_PERIC0_UART_DBG_IPCLK>;

			samsung,uart-fifosize = <256>;

			status = "disabled";
		};

		usi1: usi@104700c0 {
			compatible = "samsung,exynos850-usi";
