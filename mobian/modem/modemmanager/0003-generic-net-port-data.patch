--- a/src/plugins/generic/mm-plugin-generic.c
+++ b/src/plugins/generic/mm-plugin-generic.c
@@ -58,6 +58,9 @@
               GList *probes,
               GError **error)
 {
+    MMBroadbandModem *modem;
+    GList            *l;
+
 #if defined WITH_QMI
     if (mm_port_probe_list_has_qmi_port (probes)) {
         mm_obj_dbg (self, "QMI-powered generic modem found...");
@@ -82,12 +85,26 @@
     }
 #endif
 
-    return MM_BASE_MODEM (mm_broadband_modem_new (uid,
-                                                  physdev,
-                                                  drivers,
-                                                  mm_plugin_get_name (self),
-                                                  vendor,
-                                                  product));
+    modem = mm_broadband_modem_new (uid,
+                                    physdev,
+                                    drivers,
+                                    mm_plugin_get_name (self),
+                                    vendor,
+                                    product);
+
+    /* A net port tagged ID_MM_NET_CGACT is connected by the generic bearer with
+     * +CGACT/+CGCONTRDP: let it be a data port */
+    for (l = probes; l; l = g_list_next (l)) {
+        MMKernelDevice *port = mm_port_probe_peek_port (MM_PORT_PROBE (l->data));
+
+        if (port && mm_kernel_device_get_global_property_as_boolean (port, "ID_MM_NET_CGACT")) {
+            mm_obj_dbg (self, "generic modem with a +CGACT net port found...");
+            g_object_set (modem, MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE, NULL);
+            break;
+        }
+    }
+
+    return MM_BASE_MODEM (modem);
 }
 
