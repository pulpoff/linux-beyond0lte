@@ -582,6 +597,34 @@ impl Viewfinder {
     ///
     /// This operation may take a while. The resolution might be changed
     /// temporarily, autofocusing might take place, etc. Basically
+    /// Sets the digital zoom (1.0 = none), camerabin's own: the camera source is cropped and scaled back, so the
+    /// viewfinder, pictures and videos all get it. Clamped to 1.0 ..= 8.0 (and camerabin's max-zoom); returns the
+    /// factor applied.
+    pub fn set_zoom(&self, zoom: f64) -> f64 {
+        let camerabin = self.imp().camerabin();
+        let max = (camerabin.property::<f32>("max-zoom") as f64).clamp(1.0, 8.0);
+        let zoom = zoom.clamp(1.0, max);
+        camerabin.set_property("zoom", zoom as f32);
+        zoom
+    }
+
+    /// The largest zoom set_zoom() applies.
+    pub fn max_zoom(&self) -> f64 {
+        (self.imp().camerabin().property::<f32>("max-zoom") as f64).clamp(1.0, 8.0)
+    }
+
+    /// Magnifies the drawn viewfinder by `factor` on top of the zoom in use, without touching the pipeline:
+    /// smooth while a pinch is in progress. 1.0 = off.
+    pub fn set_preview_zoom(&self, factor: f64) {
+        self.imp().preview_zoom.set(factor);
+        self.queue_draw();
+    }
+
+    /// The digital zoom in use (1.0 = none).
+    pub fn zoom(&self) -> f64 {
+        self.imp().camerabin().property::<f32>("zoom") as f64
+    }
