+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupts-extended = <&gpa2 2 IRQ_TYPE_LEVEL_LOW>;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		#sound-dai-cells = <1>;
+
+		AVDD-supply = <&ldo17m>;
