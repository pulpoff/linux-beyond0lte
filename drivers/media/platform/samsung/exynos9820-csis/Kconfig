config VIDEO_EXYNOS9820_CSIS
	tristate "Exynos 9820 MIPI CSI-2 receiver"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV && OF
	depends on ARCH_EXYNOS || COMPILE_TEST
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	select VIDEOBUF2_DMA_CONTIG
	help
	  The camera receiver of the Exynos 9820 (Galaxy S10 family): the
	  CSIS v5.2 links and their write DMAs, giving raw Bayer frames to
	  memory for a software ISP such as libcamera's.
