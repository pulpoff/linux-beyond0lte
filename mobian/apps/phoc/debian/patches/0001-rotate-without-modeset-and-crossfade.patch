+/*
+ * The last frame, kept before a rotation commits: the shield shows it turned upright in place of black
+ * while clients re-layout, then grows and fades it away (on_transaction_active_changed). Its swapchain
+ * buffer stays locked meanwhile, so the swapchain draws into the others (reading it back cost ~0.1 s).
+ */
+static void
+phoc_output_snapshot_for_rotation (PhocOutput *self, enum wl_output_transform new_transform)
+{
+  PhocOutputPrivate *priv = phoc_output_get_instance_private (self);
+  struct wlr_output *wlr_output = self->wlr_output;
+  struct wlr_renderer *renderer = wlr_output->renderer;
+  struct wlr_texture *texture;
+  gboolean owned = FALSE;
+
+  /* turned again while the last turn still fades: the frame on screen is that fade (the old frame shrunk
+   * on black), so a snapshot of it would shrink again at every turn; turn the snapshot already up instead */
+  if (priv->shield &&
+      phoc_output_shield_turn_snapshot (priv->shield,
+                                        wlr_output_transform_compose (wlr_output_transform_invert (wlr_output->transform),
+                                                                      new_transform))) {
+    priv->rotation_fade = TRUE;
+    return;
+  }
+
+  if (!priv->last_buffer || !wlr_output->swapchain || !renderer)
+    return;
+
+  /* still one of the swapchain's buffers? (a new swapchain frees the old ones) */
+  for (size_t i = 0; i < WLR_SWAPCHAIN_CAP; i++)
+    owned |= wlr_output->swapchain->slots[i].buffer == priv->last_buffer;
+  if (!owned)
+    return;
+
+  texture = wlr_texture_from_buffer (renderer, priv->last_buffer);
+  if (!texture) {
+    g_debug ("No snapshot for the rotation of %s", wlr_output->name);
+    return;
+  }
+
+  if (priv->shield == NULL)
+    priv->shield = phoc_output_shield_new (self);
+  phoc_output_shield_set_snapshot (priv->shield, wlr_buffer_lock (priv->last_buffer), texture,
+                                   wlr_output_transform_compose (wlr_output_transform_invert (wlr_output->transform),
+                                                                 new_transform));
+  priv->rotation_fade = TRUE;
+}
+
