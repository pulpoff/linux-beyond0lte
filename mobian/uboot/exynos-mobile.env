stdin=serial,button-kbd
/* Quiet by default: S-Boot's Debian logo (up_param logo.jpg) stays on the
 * screen (NO_FB_CLEAR). s10e_screen brings the text console up for the
 * menu and for a failed boot. */
stdout=serial
stderr=serial

bootdelay=0
kernel_addr_r=0xa8000000
ramdisk_addr_r=0xb0000000
s10e_part=20
s10e_args=console=tty0 quiet splash phy_exynos5_usbdrd.exynos9820_ss=0 loglevel=3 vt.global_cursor_default=0 systemd.show_status=false udev.log_level=3 panic=0 s10e.root=PARTLABEL=linux
s10e_args_verbose=console=tty0 loglevel=7 phy_exynos5_usbdrd.exynos9820_ss=0 panic=0 s10e.root=PARTLABEL=linux

s10e_screen=setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; cls

/* S-Boot picks recovery/download/normal from PMU registers that only the
 * Samsung kernel ever resets (drivers/samsung/sec_reboot.c): INFORM3
 * 0x1586080c = 0x12345670 | reason (0 normal, 1 download, 4 recovery),
 * INFORM2 0x15860808 bits 16-23 = 0x4e (normal, not LPM charging), and
 * SYSIP_DAT0 0x15860810 = 0xff for recovery. A bare reset leaves the old
 * "recovery" there, so every restart came back here. */
s10e_reason=setexpr.l s10e_i2 *0x15860808 "&" 0xff00ffff;
	setexpr s10e_i2 ${s10e_i2} "|" 0x4e0000;
	mw.l 0x15860808 ${s10e_i2};
	mw.l 0x15860810 ${s10e_sysip};
	mw.l 0x1586080c ${s10e_inform3}

s10e_normal=setenv s10e_sysip 0; setenv s10e_inform3 0x12345670; run s10e_reason

reboot_lineage=run s10e_normal; reset

reboot_download=setenv s10e_sysip 0; setenv s10e_inform3 0x12345671;
	run s10e_reason; reset

bootcmd=mw.l 0x19030070 0x1281 1;
	run s10e_normal;
	run s10e_boot;
	run s10e_screen;
	echo "Boot failed:";
	run s10e_load;
	echo "Any key: menu";
	pause;
	bootmenu

s10e_image=Image

s10e_load=ufs init;
	scsi scan;
	if part number scsi 0 linux s10e_part; then
		echo "S10e: linux = scsi 0:${s10e_part} (hex)";
	else
		echo "S10e: no partition named linux, trying 0:${s10e_part}";
	fi;
	ls scsi 0:${s10e_part} /boot/s10e;
	if load scsi 0:${s10e_part} ${kernel_addr_r} /boot/s10e/bootargs.env; then
		echo "S10e: bootargs from /boot/s10e/bootargs.env";
		env import -t ${kernel_addr_r} ${filesize} s10e_args;
	fi;
	echo "S10e: loading ${s10e_image}";
	load scsi 0:${s10e_part} ${kernel_addr_r} /boot/s10e/${s10e_image} &&
	echo "S10e: loading initramfs" &&
	load scsi 0:${s10e_part} ${ramdisk_addr_r} /boot/s10e/initramfs.cpio.gz &&
	setenv rd_size ${filesize} &&
	echo "S10e: booting, initramfs ${rd_size} bytes"

s10e_boot=run s10e_load &&
	setenv bootargs "${s10e_args}" &&
	booti ${kernel_addr_r} ${ramdisk_addr_r}:${rd_size} ${fdtcontroladdr}

s10e_stay=run s10e_load &&
	setenv bootargs "${s10e_args_verbose} s10e.stay" &&
	booti ${kernel_addr_r} ${ramdisk_addr_r}:${rd_size} ${fdtcontroladdr}

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

bootmenu_0=Mobian=run s10e_boot
bootmenu_1=Mobian, previous kernel=setenv s10e_image Image.prev; run s10e_boot
bootmenu_2=Rescue shell (USB)=run s10e_stay
bootmenu_3=LineageOS=run reboot_lineage
bootmenu_4=Download mode=run reboot_download
bootmenu_5=Fastboot (broken)=run fastbootcmd
bootmenu_6=Console=echo "type: bootmenu"
bootmenu_7=Power off=run s10e_normal; poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=mw.l 0x19030070 0x1281 1; run s10e_screen; bootmenu
