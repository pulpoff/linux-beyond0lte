+/**
+ * phosh_shell_suppress_osd:
+ * @self: The shell
+ * @msec: For how long
+ *
+ * Closes the on screen display and keeps it closed for @msec, e.g. while a screenshot is taken.
+ */
+void
+phosh_shell_suppress_osd (PhoshShell *self, guint msec)
+{
+  PhoshShellPrivate *priv;
+
+  g_return_if_fail (PHOSH_IS_SHELL (self));
+  priv = phosh_shell_get_instance_private (self);
+
+  priv->osd_suppress_until = g_get_monotonic_time () + msec * G_TIME_SPAN_MILLISECOND;
+  if (priv->osd)
+    gtk_widget_destroy (GTK_WIDGET (priv->osd));
+}
