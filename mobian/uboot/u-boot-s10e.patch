 	pause;
 	bootmenu
 
+s10e_image=Image
+
+s10e_load=ufs init;
+	scsi scan;
+	if part number scsi 0 linux s10e_part; then
+		echo "S10e: linux = scsi 0:${s10e_part} (hex)";
+	else
+		echo "S10e: no partition named linux, trying 0:${s10e_part}";
+	fi;
+	ls scsi 0:${s10e_part} /boot/s10e;
+	if load scsi 0:${s10e_part} ${kernel_addr_r} /boot/s10e/bootargs.env; then
+		echo "S10e: bootargs from /boot/s10e/bootargs.env";
+		env import -t ${kernel_addr_r} ${filesize} s10e_args;
+	fi;
+	echo "S10e: loading ${s10e_image}";
