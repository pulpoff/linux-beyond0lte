		usi10: usi@109200c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x109200c0 0x20>;
			ranges;

			clock-names = "pclk",
				      "ipclk";
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI10_USI_PCLK>,
				 <&cmu_peric1 CLK_GOUT_PERIC1_USI10_USI_IPCLK>;

			#address-cells = <1>;
			#size-cells = <1>;

			samsung,sysreg = <&sysreg_peric1 0x1038>;
			status = "disabled";

			hsi2c_24: i2c@10920000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x10920000 0xc0>;
				interrupts = <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH>;

				clock-names = "hsi2c",
					      "hsi2c_pclk";
				clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI10_USI_IPCLK>,
					 <&cmu_peric1 CLK_GOUT_PERIC1_USI10_USI_PCLK>;

				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		cmu_fsys0a: clock-controller@10a00000 {
			compatible = "samsung,exynos9820-cmu-fsys0a";
			reg = <0x10a00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "usb31drd",
				      "usbdp_debug";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0A_BUS>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0A_USBDP_DEBUG>;
		};

		/*
		 * USB 2.0 PHY + USB/DP gen2 combo PHY (downstream: phy_version
		 * 0x301, sub_phy_version 0x400): link/ctrl, PCS, PMA.
		 */
		usbdrd_phy: phy@10b00000 {
			compatible = "samsung,exynos9820-usbdrd-phy";
			reg = <0x10b00000 0x200>,
			      <0x10af0000 0x800>,
			      <0x10ae0000 0x2800>;
			reg-names = "phy", "pcs", "pma";
			#phy-cells = <1>;

			clock-names = "phy",
				      "ref",
				      "scl_pclk",
				      "pcs_pclk",
				      "pma_ref";
			clocks = <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_ACLK_PHYCTRL>,
				 <&oscclk>,
				 <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_I_USBDPPHY_SCL_APB_PCLK>,
				 <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_I_USBPCS_APB_CLK>,
				 <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_I_USBDPPHY_REF_SOC_PLL>;

			samsung,pmu-syscon = <&pmu_system_controller>;

			status = "disabled";
		};

		/* DisplayPort link controller, on the USB/DP combo PHY (phy index 2) */
		displayport: displayport@130b0000 {
			compatible = "samsung,exynos9820-dp";
			reg = <0x130b0000 0x10000>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cmu_top CLK_GOUT_CMU_FSYS0_DPGTC>;
			clock-names = "gtc";
			phys = <&usbdrd_phy 2>;
			phy-names = "dp";
			status = "disabled";
		};

		usbdrd: usb@10c00000 {
			compatible = "samsung,exynos850-dwusb3";
			ranges = <0x0 0x10c00000 0x10000>;

			clock-names = "bus_early",
				      "ref";
			clocks = <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_BUS_CLK_EARLY>,
				 <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_I_USB31DRD_REF_CLK_40>;

			#address-cells = <1>;
			#size-cells = <1>;

			status = "disabled";

			usbdrd_dwc3: usb@0 {
				compatible = "snps,dwc3";
				reg = <0x0 0x10000>;
				interrupts = <GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH>;
				phys = <&usbdrd_phy 0>, <&usbdrd_phy 1>;
				phy-names = "usb2-phy", "usb3-phy";
				/*
				 * Downstream sets "super-speed-plus" but its
				 * dwc3 core forces LLUCTL.FORCE_GEN1 on this
				 * DWC_usb31; mainline does the same for host
				 * mode only with "super-speed".
				 */
				maximum-speed = "super-speed";
				/*
				 * The combo PHY's LC PLL does not lock while the
				 * link holds the PIPE in P3; downstream clears
				 * SUSPHY before every PHY init ("DP altmode
				 * issue") and re-inits per attach.
				 */
				snps,dis_u3_susphy_quirk;
				/*
				 * Downstream GUSB3PIPECTL bits for this PHY
				 * (beyond0 dwc3 node, "defined in MK"): the PCS
				 * elastic buffer is set up nominal empty
				 * (skp_remove_th = 1, no init buffering), so
				 * the link must say so on the PIPE, plus Ux
				 * exit in Px and U1/U2 exit fail -> Recovery.
				 * Downstream also sets DISRXDETINP3 (Rx.Detect
				 * in P2): its "revision >= 2.50a" test is true
				 * for every DWC_usb31.
				 */
				snps,dis_rxdet_inp3_quirk;
				snps,elastic-buf-mode-quirk;
				snps,ux-exit-in-px-quirk;
				snps,u1u2-exitfail-quirk;
			};
		};

		cmu_fsys0: clock-controller@13000000 {
			compatible = "samsung,exynos9820-cmu-fsys0";
			reg = <0x13000000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_BUS>;
			samsung,sysreg = <&sysreg_fsys0>;
		};

		sysreg_fsys0: syscon@13020000 {
			compatible = "samsung,exynos9820-fsys0-sysreg", "syscon";
			reg = <0x13020000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		pinctrl_fsys0: pinctrl@13030000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x13030000 0x1000>;
			interrupts = <GIC_SPI 240 IRQ_TYPE_LEVEL_HIGH>;
		};

		cmu_fsys1: clock-controller@13c00000 {
			compatible = "samsung,exynos9820-cmu-fsys1";
			reg = <0x13c00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus",
				      "mmc_card",
				      "pcie",
				      "ufs_card",
				      "ufs_embd";
			clocks = <&oscclk>,
				 <&cmu_top CLK_GOUT_CMU_FSYS1_BUS>,
				 <&cmu_top CLK_GOUT_CMU_FSYS1_MMC_CARD>,
				 <&cmu_top CLK_GOUT_CMU_FSYS1_PCIE>,
				 <&cmu_top CLK_GOUT_CMU_FSYS1_UFS_CARD>,
				 <&cmu_top CLK_GOUT_CMU_FSYS1_UFS_EMBD>;
			samsung,sysreg = <&sysreg_fsys1>;
		};

		sysreg_fsys1: syscon@13c10000 {
			compatible = "samsung,exynos9820-fsys1-sysreg", "syscon";
			reg = <0x13c10000 0x1200>;
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_SYSREG_FSYS1_PCLK>;
		};

		/* GEN2 root complex for the Wi-Fi (downstream pcie_0) */
		pcie_wifi: pcie@13f00000 {
			compatible = "samsung,exynos9820-pcie";
			reg = <0x13f00000 0x1000>,
			      <0x13ed0000 0x1000>,
			      <0x13ef0000 0x1000>,
			      <0x13ee0000 0x200>,
			      <0x14ffe000 0x2000>;
			reg-names = "dbi", "elbi", "phy", "pcs", "config";
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			ranges = <0x82000000 0 0x14000000 0x14000000 0 0x00ff0000>;
			bus-range = <0x00 0xff>;
			num-lanes = <1>;
			max-link-speed = <1>;
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0>;
			interrupt-map = <0 0 0 0 &gic GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
			samsung,pmu-syscon = <&pmu_system_controller>;
			samsung,sysreg = <&sysreg_fsys1>;
			status = "disabled";
		};

		pinctrl_fsys1: pinctrl@13c40000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x13c40000 0x1000>;
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_GPIO_FSYS1_PCLK>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH>;
		};

		ufs: ufs@13d60000 {
			compatible = "samsung,exynos9820-ufs";
			reg = <0x13d60000 0x200>,	/* 0: HCI standard */
			      <0x13d61100 0x200>,	/* 1: Vendor specificed */
			      <0x13d50000 0x8000>,	/* 2: UNIPRO */
			      <0x13d70000 0x100>;	/* 3: UFS protector */
			reg-names = "hci", "vs_hci", "unipro", "ufsp";

			interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "core_clk",
				      "sclk_unipro_main",
				      "fmp";
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_UFS_EMBD_I_ACLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_UFS_EMBD_I_CLK_UNIPRO>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_UFS_EMBD_I_FMP_CLK>;
			freq-table-hz = <0 0>,
					<0 0>,
					<0 0>;

#if 0
			pinctrl-names = "default";
			pinctrl-0 = <&ufs_rst_n &ufs_refclk_out>;
#endif

			phys = <&ufs_phy>;
			phy-names = "ufs-phy";

			dma-coherent;
			samsung,sysreg = <&sysreg_fsys1 0x700>;

			status = "disabled";
		};

		ufs_phy: ufs-phy@13d64000 {
			compatible = "samsung,exynos9820-ufs-phy";
			reg = <0x13d64000 0x800>;
			reg-names = "phy-pma";
			#phy-cells = <0>;
			samsung,pmu-syscon = <&pmu_system_controller>;
		};

		pinctrl_vts: pinctrl@15580000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x15580000 0x1000>;
		};

		cmu_apm: clock-controller@15800000 {
			compatible = "samsung,exynos9820-cmu-apm";
			reg = <0x15800000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_APM_BUS>;
			samsung,sysreg = <&sysreg_apm>;
		};

		sysreg_apm: syscon@15820000 {
			compatible = "samsung,exynos9820-apm-sysreg", "syscon";
			reg = <0x15820000 0x10000>;
			clocks = <&cmu_apm CLK_GOUT_APM_SYSREG_APM_PCLK>;
		};

		pinctrl_alive: pinctrl@15850000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x15850000 0x1000>;

			wakeup-interrupt-controller {
				compatible = "samsung,exynos7-wakeup-eint";
			};
		};

		pmu_system_controller: system-controller@15860000 {
			compatible = "samsung,exynos9820-pmu",
				     "samsung,exynos7-pmu",
				     "syscon";
			reg = <0x15860000 0x10000>;

			google,pmu-intr-gen-syscon = <&pmu_intr_gen>;

			poweroff: syscon-poweroff {
				compatible = "syscon-poweroff";
				regmap = <&pmu_system_controller>;
				offset = <0x030c>; /* PS_HOLD_CONTROL */
				mask = <0x100>;
				value = <0x0>; /* De-assert PS_HOLD_EN */
			};

			reboot: syscon-reboot {
				compatible = "syscon-reboot";
				regmap = <&pmu_system_controller>;
				offset = <0x3a00>; /* SWRESET */
				mask = <0x2>;
			};

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x080c>; /* SEC_DEBUG_PANIC_INFORM */

				mode-download = <0x12345671>;
				mode-charging = <0x12345673>;
				mode-recovery = <0x12345674>;
				mode-bootloader = <0x1234567d>;
			};
		};

		pd_aud: power-domain@15861900 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861900 0x20>;
			#power-domain-cells = <0>;
			label = "AUD";
			samsung,tzpc-base = <0x18c62000>;
		};

		pd_npu0: power-domain@15861d00 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861d00 0x20>;
			#power-domain-cells = <0>;
			label = "NPU0";
		};

		pd_npu1: power-domain@15861d80 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861d80 0x20>;
			#power-domain-cells = <0>;
			power-domains = <&pd_npu0>;
			label = "NPU1";
		};

		pd_dpu: power-domain@15861e00 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861e00 0x20>;
			#power-domain-cells = <0>;
			label = "DPU";

			/*
			 * Disabled until a proper display panel is implemented.
			 * Make sure to mark pd_isppre as a child after enabling.
			 */
			status = "disabled";
		};

		pd_dspm: power-domain@15861e80 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861e80 0x20>;
			#power-domain-cells = <0>;
			label = "DSPM";
		};

		pd_dsps: power-domain@15861f00 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15861f00 0x20>;
			#power-domain-cells = <0>;
			power-domains = <&pd_dspm>;
			label = "DSPS";
		};

		pd_embedded_g3d: power-domain@15862100 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862100 0x20>;
			#power-domain-cells = <0>;
			label = "G3D";
		};

		pd_fsys0a: power-domain@15862200 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862200 0x20>;
			#power-domain-cells = <0>;
			label = "FSYS0A";
			status = "disabled";
		};

		pd_g2d: power-domain@15862300 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862300 0x20>;
			#power-domain-cells = <0>;
			label = "G2D";
		};

		pd_isphq: power-domain@15862400 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862400 0x20>;
			#power-domain-cells = <0>;
			label = "ISPHQ";
		};

		pd_isplp: power-domain@15862480 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862480 0x20>;
			#power-domain-cells = <0>;
			label = "ISPLP";
		};

		pd_isppre: power-domain@15862500 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862500 0x20>;
			#power-domain-cells = <0>;
			/* power-domains = <&pd_dpu>; */
			label = "ISPPRE";
			/* stock need_smc: EL3 restores the block's TZPC on power-up */
			samsung,tzpc-base = <0x17010204>;
		};

		pd_iva: power-domain@15862580 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862580 0x20>;
			#power-domain-cells = <0>;
			label = "IVA";
		};

		pd_mfc: power-domain@15862600 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862600 0x20>;
			#power-domain-cells = <0>;
			label = "MFC";
			/* stock need_smc, pm-domains.dtsi */
			samsung,tzpc-base = <0x18820204>;
		};


		pd_vts: power-domain@15862a80 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862a80 0x20>;
			#power-domain-cells = <0>;
			label = "VTS";
		};

		pd_vra2: power-domain@15862b00 {
			compatible = "samsung,exynos9820-pd";
			reg = <0x15862b00 0x20>;
			#power-domain-cells = <0>;
			power-domains = <&pd_isplp>;
			label = "VRA2";
		};

		pmu_intr_gen: syscon@15870000 {
			compatible = "samsung,exynos9820-pmu-intr-gen", "syscon";
			reg = <0x15870000 0x1000>;
		};

		ap2apm_mailbox: mailbox@15900000 {
			compatible = "google,gs101-mbox";
			reg = <0x15900000 0x1000>;
			clocks = <&cmu_apm CLK_GOUT_APM_MAILBOX_APM_AP_PCLK>;
			clock-names = "pclk";
			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			#mbox-cells = <0>;
		};

		cmu_cmgp: clock-controller@15c00000 {
			compatible = "samsung,exynos9820-cmu-cmgp";
			reg = <0x15c00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_apm CLK_DOUT_CMU_CMGP_BUS>;
			samsung,sysreg = <&sysreg_cmgp>;
		};

		sysreg_cmgp: syscon@15c20000 {
			compatible = "samsung,exynos9820-cmgp-sysreg", "syscon";
			reg = <0x15c20000 0x10000>;
			clocks = <&cmu_cmgp CLK_GOUT_CMGP_SYSREG_CMGP_PCLK>;
		};

		pinctrl_cmgp: pinctrl@15c30000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x15c30000 0x1000>;
			clocks = <&cmu_cmgp CLK_GOUT_CMGP_GPIO_CMGP_PCLK>;
			clock-names = "pclk";

			wakeup-interrupt-controller {
				compatible = "samsung,exynos7-wakeup-eint";
			};
		};

		usi_i2c_cmgp1: usi@15d300c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x15d300c0 0x20>;
			ranges;

			clock-names = "pclk",
				      "ipclk";
			clocks = <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_PCLK>,
				 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_IPCLK>;

			#address-cells = <1>;
			#size-cells = <1>;

			samsung,sysreg = <&sysreg_cmgp 0x2014>;
			status = "disabled";

			hsi2c_42: i2c@15d30000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x15d30000 0xc0>;
				interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;

				clock-names = "hsi2c",
					      "hsi2c_pclk";
				clocks = <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_IPCLK>,
					 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_PCLK>;

				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		usi_cmgp3: usi@15d600c0 {
			compatible = "samsung,exynos850-usi";
			reg = <0x15d600c0 0x20>;
			ranges;

			clock-names = "pclk",
				      "ipclk";
			clocks = <&cmu_cmgp CLK_GOUT_CMGP_USI_CMGP3_PCLK>,
				 <&cmu_cmgp CLK_GOUT_CMGP_USI_CMGP3_IPCLK>;

			#address-cells = <1>;
			#size-cells = <1>;

			samsung,sysreg = <&sysreg_cmgp 0x2030>;
			status = "disabled";

			hsi2c45: i2c@15d60000 {
				compatible = "samsung,exynosautov9-hsi2c";
				reg = <0x15d60000 0xc0>;

				clock-names = "hsi2c",
					      "hsi2c_pclk";
				clocks = <&cmu_cmgp CLK_GOUT_CMGP_USI_CMGP3_IPCLK>,
					 <&cmu_cmgp CLK_GOUT_CMGP_USI_CMGP3_PCLK>;

				interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-0 = <&hsi2c45_bus>;
				pinctrl-names = "default";

				#address-cells = <1>;
				#size-cells = <0>;

				status = "disabled";
			};
		};

		cmu_g3d: clock-controller@18400000 {
			compatible = "samsung,exynos9820-cmu-g3d";
			reg = <0x18400000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk";
			clocks = <&oscclk>;
			samsung,sysreg = <&sysreg_g3d>;
		};

		sysreg_g3d: syscon@18420000 {
			compatible = "samsung,exynos9820-g3d-sysreg", "syscon";
			reg = <0x18420000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		/*
		 * No power-domains: switching G3D back on needs an EL3 call to
		 * restore its TZPC, which the mainline PD driver does not make.
		 * Boards keep pd_embedded_g3d in the state the bootloader left.
		 * Downstream runs the GPU non-coherent, hence no dma-coherent.
		 */
		gpu: gpu@18500000 {
			compatible = "samsung,exynos9820-mali", "arm,mali-bifrost";
			reg = <0x18500000 0x5000>;
			interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "job", "mmu", "gpu";
			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_G3D>;
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;
			status = "disabled";
		};

		pinctrl_aud: pinctrl@18c60000 {
			compatible = "samsung,exynos9820-pinctrl";
			reg = <0x18c60000 0x1000>;
		};

		/*
		 * The ABOX's own IOMMU. The calliope firmware runs from fixed
		 * IOVAs (DRAM at 0x80000000, VSS at 0xa0000000, ...), so the
		 * ABOX driver attaches its own domain and maps everything.
		 */
		sysmmu_aud: iommu@18e00000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x18e00000 0x9000>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&pd_aud>;
			/*
			 * Unreadable until pd_aud has been cycled (TZPC restore),
			 * so no version probe; its clock gate is CMU_AUD's own.
			 * Register layout = mainline's v7 non-VM variant (stock
			 * fault regs 0x70/0x78, PT_BASE_PPN 0x0c).
			 */
			samsung,sysmmu-version = <7 0>;
			#iommu-cells = <0>;
		};

		abox: audio-controller@18c50000 {
			compatible = "samsung,exynos9820-abox";
			/* sysreg: read only with the AUD PLL running (SoC hangs otherwise) */
			reg = <0x18c50000 0x10000>,
			      <0x18c00000 0x10000>,
			      <0x18d00000 0x59000>,
			      <0x18ce0000 0x10000>,
			      <0x18c10000 0x10000>,
			      <0x18cf1000 0x1000>,
			      <0x18cf2000 0x1004>;
			reg-names = "sfr", "cmu", "sram", "timer", "sysreg",
				    "gicd", "gicc";
			/* the ABOX GIC's output towards the AP */
			interrupts = <GIC_SPI 46 IRQ_TYPE_EDGE_RISING>;
			iommus = <&sysmmu_aud>;
			power-domains = <&pd_aud>;
			samsung,pmu-syscon = <&pmu_system_controller>;
			#sound-dai-cells = <1>;
			status = "disabled";
		};

		/*
		 * CMU_ISPPRE is in pd_isppre, so it has runtime PM; S-Boot leaves
		 * the bus at /16 (25 MHz), stock runs it undivided.
		 */
		cmu_isppre: clock-controller@17000000 {
			compatible = "samsung,exynos9820-cmu-isppre";
			reg = <0x17000000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk", "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
			assigned-clocks = <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>,
					  <&cmu_isppre CLK_MOUT_ISPPRE_BUS_USER>;
			assigned-clock-rates = <400000000>, <0>;
			assigned-clock-parents = <0>,
						 <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
			power-domains = <&pd_isppre>;
		};

		/*
		 * Camera receivers: CSIS n with write DMA n (VC0 straight to
		 * memory). The PHYs sit in the DPU block; their isolation is in the
		 * PMU (0x70c for CSIS0, shared with the DSI: only ever set, 0x730
		 * for the others) and their resets in SYSREG_ISPPRE 0x500. Never
		 * the CMU pclk, XIU_P or LHM_AXI_P clocks here: turning those off
		 * cuts the ISPPRE P-bus.
		 */
		csis0: csis@17030000 {
			compatible = "samsung,exynos9820-csis";
			reg = <0x17030000 0x1000>, <0x170a0000 0x1000>,
			      <0x19160b00 0x500>, <0x170e0000 0x100>,
			      <0x17020000 0x1000>, <0x1586070c 0x4>;
			reg-names = "csis", "wdma", "phy", "dma-top", "sysreg", "pmu-iso";
			interrupts = <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 315 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "csis", "dma";
			clocks = <&cmu_isppre CLK_GOUT_ISPPRE_CSIS0_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_CSISX4_PDP_DMA_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSMMU_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_XIU_D_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_C2CLK_CSISX4_PDP>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_PCLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_LHS_AXI_D_ISPPRE_CLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSREG_ISPPRE_PCLK>;
			power-domains = <&pd_isppre>;
			samsung,csis-id = <0>;
			samsung,phy-reset-bit = <0>;
			samsung,dc-combo-phy;
			status = "disabled";
		};

		csis1: csis@17040000 {
			compatible = "samsung,exynos9820-csis";
			reg = <0x17040000 0x1000>, <0x170b0000 0x1000>,
			      <0x19162b00 0x500>, <0x170e0000 0x100>,
			      <0x17020000 0x1000>, <0x15860730 0x4>;
			reg-names = "csis", "wdma", "phy", "dma-top", "sysreg", "pmu-iso";
			interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "csis", "dma";
			clocks = <&cmu_isppre CLK_GOUT_ISPPRE_CSIS1_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_CSISX4_PDP_DMA_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSMMU_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_XIU_D_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_C2CLK_CSISX4_PDP>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_PCLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_LHS_AXI_D_ISPPRE_CLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSREG_ISPPRE_PCLK>;
			power-domains = <&pd_isppre>;
			samsung,csis-id = <1>;
			samsung,phy-reset-bit = <2>;
			status = "disabled";
		};

		csis2: csis@17050000 {
			compatible = "samsung,exynos9820-csis";
			reg = <0x17050000 0x1000>, <0x170c0000 0x1000>,
			      <0x19162300 0x500>, <0x170e0000 0x100>,
			      <0x17020000 0x1000>, <0x15860730 0x4>;
			reg-names = "csis", "wdma", "phy", "dma-top", "sysreg", "pmu-iso";
			interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 317 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "csis", "dma";
			clocks = <&cmu_isppre CLK_GOUT_ISPPRE_CSIS2_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_CSISX4_PDP_DMA_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSMMU_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_XIU_D_ISPPRE_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_C2CLK_CSISX4_PDP>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_ACLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_QE_CSISX4_PDP_PCLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_LHS_AXI_D_ISPPRE_CLK>,
				 <&cmu_isppre CLK_GOUT_ISPPRE_SYSREG_ISPPRE_PCLK>;
			power-domains = <&pd_isppre>;
			samsung,csis-id = <2>;
			samsung,phy-reset-bit = <1>;
			samsung,dc-combo-phy;
			status = "disabled";
		};

		/*
		 * In pd_mfc, which power-cycles: the driver saves and restores
		 * the whole CMU. A cold one comes up on OSCCLK, hence the
		 * assigned parents.
		 */
		cmu_mfc: clock-controller@18800000 {
			compatible = "samsung,exynos9820-cmu-mfc";
			reg = <0x18800000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk", "bus", "wfd";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MFC_MFC>,
				 <&cmu_top CLK_DOUT_CMU_MFC_WFD>;
			assigned-clocks = <&cmu_mfc CLK_MOUT_MFC_MFC_USER>,
					  <&cmu_mfc CLK_MOUT_MFC_WFD_USER>,
					  <&cmu_mfc CLK_DOUT_MFC_BUSP>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_MFC_MFC>,
						 <&cmu_top CLK_DOUT_CMU_MFC_WFD>,
						 <0>;
			assigned-clock-rates = <0>, <0>, <33333334>;	/* S-Boot: /4 */
			power-domains = <&pd_mfc>;
		};

		/*
		 * The MFC's two SysMMUs (its D0/D1 bus ports). Version 7.3 read
		 * from 0x34 with the domain on; given here so probe reads
		 * nothing (the v7 capability offsets are holes). The clock makes
		 * CMU_MFC resume, and restore itself, before they are programmed.
		 */
		sysmmu_mfc0: iommu@18890000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x18890000 0x9000>;
			interrupts = <GIC_SPI 343 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "sysmmu";
			clocks = <&cmu_mfc CLK_GOUT_MFC_SYSMMU_MFCD0_CLK>;
			power-domains = <&pd_mfc>;
			samsung,sysmmu-version = <7 3>;
			#iommu-cells = <0>;
		};

		sysmmu_mfc1: iommu@188b0000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x188b0000 0x9000>;
			interrupts = <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "sysmmu";
			clocks = <&cmu_mfc CLK_GOUT_MFC_SYSMMU_MFCD1_CLK>;
			power-domains = <&pd_mfc>;
			samsung,sysmmu-version = <7 3>;
			#iommu-cells = <0>;
		};

		/* MFC v13 (ip_ver 0x1300), firmware s5p-mfc-v13.fw */
		mfc: video-codec@188d0000 {
			compatible = "samsung,exynos9820-mfc";
			reg = <0x188d0000 0x10000>;
			interrupts = <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "mfc";
			clocks = <&cmu_mfc CLK_GOUT_MFC_MFC_ACLK>;
			iommus = <&sysmmu_mfc0>, <&sysmmu_mfc1>;
			power-domains = <&pd_mfc>;
			status = "disabled";
		};

		cmu_dpu: clock-controller@19000000 {
			compatible = "samsung,exynos9820-cmu-dpu";
			reg = <0x19000000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_DPU_BUS>;
			samsung,sysreg = <&sysreg_dpu>;
		};

		/*
		 * Flip-only takeover of the pipeline S-Boot leaves running:
		 * no clocks, power domain or IOMMU on purpose (DPU-SPEC.md).
		 */
		/*
		 * SysMMU_DPUD0, in front of the VGRFS and GF0 DMA ports. S-Boot
		 * leaves it in bypass. Clocked whenever DPU is (its Q-channel is
		 * held off with CLOCK_REQ set), and it sits in pd_dpu, which
		 * stays untouched, so no clocks or power domain here.
		 * Version 7.3 (0x34 reads 0x70600000) is given because the v7
		 * capability registers are not probed: CAPA at 0x30 is a hole
		 * on this instance, and a read of a hole resets the SoC.
		 */
		sysmmu_dpud0: iommu@190a0000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x190a0000 0x9000>;
			interrupts = <GIC_SPI 212 IRQ_TYPE_LEVEL_HIGH>;
			samsung,sysmmu-version = <7 3>;
			#iommu-cells = <0>;
		};

		decon: display-controller@19030000 {
			compatible = "samsung,exynos9820-decon-handover";
			reg = <0x19030000 0x10000>,
			      <0x19071000 0x1000>,
			      <0x19080000 0x1000>;
			reg-names = "decon", "idma-gf0", "dsim";
			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&sysmmu_dpud0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		sysreg_dpu: syscon@19010000 {
			compatible = "samsung,exynos9820-dpu-sysreg", "syscon";
			reg = <0x19010000 0x10000>;
			clocks = <&cmu_dpu CLK_GOUT_DPU_SYSREG_DPU_PCLK>;
		};

		sysreg_core: syscon@1a020000 {
			compatible = "samsung,exynos9820-core-sysreg", "syscon";
			reg = <0x1a020000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_core: clock-controller@1a030000 {
			compatible = "samsung,exynos9820-cmu-core";
			reg = <0x1a030000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_CORE_BUS>;
			samsung,sysreg = <&sysreg_core>;
		};

		cmu_busc: clock-controller@1a200000 {
			compatible = "samsung,exynos9820-cmu-busc";
			reg = <0x1a200000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_BUSC_BUS>;
			samsung,sysreg = <&sysreg_busc>;
		};

		sysreg_busc: syscon@1a220000 {
			compatible = "samsung,exynos9820-busc-sysreg", "syscon";
			reg = <0x1a220000 0x10000>;
			clocks = <&cmu_busc CLK_GOUT_BUSC_SYSREG_BUSC_PCLK>;
		};

		cmu_top: clock-controller@1a240000 {
			compatible = "samsung,exynos9820-cmu-top";
			reg = <0x1a240000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk";
			clocks = <&oscclk>;
		};

		cmu_mif0: clock-controller@1bc00000 {
			compatible = "samsung,exynos9820-cmu-mif";
			reg = <0x1bc00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MIF_BUSP>;
			samsung,sysreg = <&sysreg_mif0>;
		};

		sysreg_mif0: syscon@1bc20000 {
			compatible = "samsung,exynos9820-mif0-sysreg", "syscon";
			reg = <0x1bc20000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_mif1: clock-controller@1bd00000 {
			compatible = "samsung,exynos9820-cmu-mif";
			reg = <0x1bd00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MIF_BUSP>;
			samsung,sysreg = <&sysreg_mif1>;
		};

		sysreg_mif1: syscon@1bd20000 {
			compatible = "samsung,exynos9820-mif1-sysreg", "syscon";
			reg = <0x1bd20000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_mif2: clock-controller@1be00000 {
			compatible = "samsung,exynos9820-cmu-mif";
			reg = <0x1be00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MIF_BUSP>;
			samsung,sysreg = <&sysreg_mif2>;
		};

		sysreg_mif2: syscon@1be20000 {
			compatible = "samsung,exynos9820-mif2-sysreg", "syscon";
			reg = <0x1be20000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_mif3: clock-controller@1bf00000 {
			compatible = "samsung,exynos9820-cmu-mif";
			reg = <0x1bf00000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk",
				      "bus";
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MIF_BUSP>;
			samsung,sysreg = <&sysreg_mif3>;
		};

		sysreg_mif3: syscon@1bf20000 {
			compatible = "samsung,exynos9820-mif3-sysreg", "syscon";
			reg = <0x1bf20000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		sysreg_cpucl0: syscon@1d000000 {
			compatible = "samsung,exynos9820-cpucl0-sysreg", "syscon";
			reg = <0x1d000000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_cpucl0: clock-controller@1d020000 {
			compatible = "samsung,exynos9820-cmu-cpucl0";
			reg = <0x1d020000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk";
			clocks = <&oscclk>;
			samsung,sysreg = <&sysreg_cpucl0>;
		};

		sysreg_cpucl2: syscon@1d100000 {
			compatible = "samsung,exynos9820-cpucl2-sysreg", "syscon";
			reg = <0x1d100000 0x10000>;
			/* Clock omitted to keep the clock driver simple */
		};

		cmu_cpucl2: clock-controller@1d120000 {
			compatible = "samsung,exynos9820-cmu-cpucl2";
			reg = <0x1d120000 0x10000>;
			#clock-cells = <1>;

			clock-names = "oscclk";
			clocks = <&oscclk>;
			samsung,sysreg = <&sysreg_cpucl2>;
		};

		/* TODO: interrupts, add driver support */
		/* TODO: pinctrl */
		/* TODO: pmu_system_controller */
		/* TODO: DMA */
	};

	apm_sram: sram@2039000 {
		compatible = "mmio-sram";
		reg = <0x0 0x2039000 0x30000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x2039000 0x30000>;
	};

	timer {
		compatible = "arm,armv8-timer";

		/* Hypervisor Virtual Timer interrupt is not wired to GIC */
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			    	 <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			    	 <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			    	 <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;

		/*
		 * Non-updatable, broken stock Samsung bootloader does not
		 * configure CNTFRQ_EL0
		 */
		clock-frequency = <26000000>;
	};
};

#include "exynos9820-pinctrl.dtsi"
#include "exynos9820-tmu.dtsi"
